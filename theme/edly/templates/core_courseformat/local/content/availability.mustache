{{! theme/edly/templates/core_courseformat/local/content/availability.mustache }}

{{#isfullinfo}}
  {{{ text }}}
{{/isfullinfo}}

{{^isfullinfo}}
  {{#hascampusunlock}}
    <div class="cf-locked-row cf-locked-row--campus cf-locked-row--{{campusunlocktype}}"
         role="note"
         aria-live="polite">
      <span class="cf-locked-ico" aria-hidden="true">
        <i class="ri-lock-2-line"></i>
      </span>

      <div class="cf-locked-copy">
        <div class="cf-locked-title">{{campusunlocktitle}}</div>
        <div class="cf-locked-desc">{{campusunlocktext}}</div>
      </div>

      <div class="cf-locked-actions">
        <a class="default-btn cf-locked-subscribe"
           href="{{campusunlockurl}}">
          {{campusunlockbutton}}
        </a>
      </div>

      {{#campusunlockdebug}}
        <details class="cf-restriction-debug">
          <summary>Diagnostic restriction CampusFR</summary>
          <pre>{{campusunlockdebug}}</pre>
        </details>
      {{/campusunlockdebug}}
    </div>
  {{/hascampusunlock}}

  {{^hascampusunlock}}
    <div class="availabilityinfo {{classes}}" role="note">
      {{{ text }}}
    </div>
  {{/hascampusunlock}}
{{/isfullinfo}}
