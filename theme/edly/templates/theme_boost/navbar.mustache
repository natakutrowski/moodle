{{#top_header}}
    <!-- Start Top Header Area -->
    <div class="top-header-area bg-color-0f6c76">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="header-left-content">
                        <p>{{{top_header_content}}}</p>
                    </div>
                </div>

                {{#top_header_right_content}}
                    <div class="col-lg-4">
                        <ul class="header-right-content">
                            {{{top_header_right_content}}}
                        </ul>
                    </div>
                {{/top_header_right_content}}
            </div>
        </div>
    </div>
    <!-- End Top Header Area -->
{{/top_header}}

<!-- Start Navbar Area -->
<div class="navbar-area {{output.edly_is_siteadmin}}">

    <!-- MOBILE HEADER (logo + user nav si connecté, sinon bouton Menu) -->
    <div class="main-responsive-nav">
        <div class="container">
            <div class="main-responsive-menu d-flex align-items-center">
                {{#logo_visibility}}
                    <div class="logo">
                        <a href="{{{ config.wwwroot }}}/">
                            {{#mobile_logo}}
                                <img src="{{mobile_logo}}" alt="{{sitename}}" {{#mobile_logo_styles}} style="{{{mobile_logo_styles}}}" {{/mobile_logo_styles}}>
                            {{/mobile_logo}}
                            {{^mobile_logo}}
                                <h2 {{#mobile_logo_styles}} style="{{{mobile_logo_styles}}}" {{/mobile_logo_styles}}>{{sitename}}</h2>
                            {{/mobile_logo}}
                            <img class="campus-night-logo" src="{{{config.wwwroot}}}/theme/edly/pix/campusfr-night-logo-v8.png" alt="CampusFR" loading="eager" decoding="async">
                        </a>
                    </div>
                {{/logo_visibility}}

                {{#campusdarkshowtoggle}}
                <button type="button" class="campus-dark-toggle campus-dark-toggle--mobile" data-campus-dark-toggle
                        data-campus-dark-url="{{{config.wwwroot}}}/theme/edly/dark_mode.php"
                        data-campus-dark-sesskey="{{campusdarksesskey}}"
                        data-campus-dark-label-on="{{#str}}darkmode_enable, theme_edly{{/str}}"
                        data-campus-dark-label-off="{{#str}}darkmode_disable, theme_edly{{/str}}"
                        aria-pressed="false"
                        aria-label="{{#str}}darkmode_enable, theme_edly{{/str}}"
                        title="{{#str}}darkmode_enable, theme_edly{{/str}}">
                    <svg class="campus-dark-toggle__moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.6 8.6 0 1 0 20.5 14Z"/></svg>
                    <svg class="campus-dark-toggle__sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                </button>
                {{/campusdarkshowtoggle}}

                {{! -- CONNECTÉ (non-invité) : on affiche directement le menu utilisateur }}
                {{#isloggedin}}
                    {{^isguest}}
                        <div class="ms-auto d-lg-none d-flex align-items-center gap-2 navbar-user-wrap">
                            <button class="btn btn-outline-dark btn-sm rounded-pill campus-menu-toggle campus-mobile-customer-toggle"
                                    type="button"
                                    data-bs-toggle="offcanvas"
                                    data-bs-target="#campusMobileMenu"
                                    aria-controls="campusMobileMenu"
                                    aria-label="{{#str}}mobilemenu_open_aria, theme_edly{{/str}}">
                                <span aria-hidden="true">☰</span>
                            </button>

                        </div>
                    {{/isguest}}
                {{/isloggedin}}

                {{! -- VISITEUR ou INVITÉ : actions compactes identiques à la landing }}
                {{^isloggedin}}
                    <div class="ms-auto d-lg-none">{{> theme_edly/guest_navigation_mobile }}</div>
                {{/isloggedin}}

                {{#isloggedin}}
                    {{#isguest}}
                        <div class="ms-auto d-lg-none">{{> theme_edly/guest_navigation_mobile }}</div>
                    {{/isguest}}
                {{/isloggedin}}
            </div>
        </div>
    </div>

    <!-- DESKTOP NAVBAR -->
    <div class="main-navbar">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-md navbar-light">
                {{#logo_visibility}}
                    <a class="navbar-brand" href="{{{ config.wwwroot }}}/">
                        {{#main_logo}}
                            <img src="{{main_logo}}" alt="{{sitename}}" {{#logo_styles}} style="{{{logo_styles}}}" {{/logo_styles}}>
                        {{/main_logo}}
                        {{^main_logo}}
                            <h2 {{#logo_styles}} style="{{{logo_styles}}}" {{/logo_styles}}>{{sitename}}</h2>
                        {{/main_logo}}
                        <img class="campus-night-logo" src="{{{config.wwwroot}}}/theme/edly/pix/campusfr-night-logo-v8.png" alt="CampusFR" loading="eager" decoding="async">
                    </a>
                {{/logo_visibility}}

                <div class="collapse navbar-collapse mean-menu flex-nowrap align-items-center" id="navbarSupportedContent">
                    {{#header_search_bar}}
                        {{{ edly_globalsearch_navbar }}}
                    {{/header_search_bar}}

                    <ul id="menu-primary-menu" class="navbar-nav me-3">
                        <!-- custom_menu -->
                        {{ ! output.custom_menu }}
                    </ul>

                    {{#campusdarkshowtoggle}}
                    <button type="button" class="campus-dark-toggle campus-dark-toggle--desktop" data-campus-dark-toggle
                            data-campus-dark-url="{{{config.wwwroot}}}/theme/edly/dark_mode.php"
                            data-campus-dark-sesskey="{{campusdarksesskey}}"
                            data-campus-dark-label-on="{{#str}}darkmode_enable, theme_edly{{/str}}"
                            data-campus-dark-label-off="{{#str}}darkmode_disable, theme_edly{{/str}}"
                            aria-pressed="false"
                            aria-label="{{#str}}darkmode_enable, theme_edly{{/str}}"
                            title="{{#str}}darkmode_enable, theme_edly{{/str}}">
                        <svg class="campus-dark-toggle__moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.6 8.6 0 1 0 20.5 14Z"/></svg>
                        <svg class="campus-dark-toggle__sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                    </button>
                    {{#campusdarkhintshow}}
                    <div class="campus-dark-hint" data-campus-dark-hint
                         data-campus-dark-hint-dismiss-url="{{campusdarkhintdismissurl}}"
                         data-campus-dark-hint-sesskey="{{campusdarksesskey}}"
                         hidden>
                        <button type="button" class="campus-dark-hint__close" data-campus-dark-hint-close
                                aria-label="{{#str}}darkmode_hint_close, theme_edly{{/str}}">×</button>
                        <div class="campus-dark-hint__badge">✨ {{#str}}darkmode_hint_badge, theme_edly{{/str}}</div>
                        <div class="campus-dark-hint__title">{{#str}}darkmode_hint_title, theme_edly{{/str}}</div>
                        <p class="campus-dark-hint__text">{{#str}}darkmode_hint_text, theme_edly{{/str}}</p>
                        <div class="campus-dark-hint__actions">
                            <button type="button" class="campus-dark-hint__cta" data-campus-dark-hint-try>
                                {{#str}}darkmode_hint_try, theme_edly{{/str}}
                            </button>
                            <button type="button" class="campus-dark-hint__dismiss" data-campus-dark-hint-dismiss>
                                {{#str}}darkmode_hint_dismiss, theme_edly{{/str}}
                            </button>
                        </div>
                        <div class="campus-dark-hint__arrow" aria-hidden="true"></div>
                    </div>
                    {{/campusdarkhintshow}}
                    {{/campusdarkshowtoggle}}

                    {{> theme_edly/guest_navigation }}

                    {{#isloggedin}}
                        {{^isguest}}
                            {{> theme_edly/customer_navigation }}
                        {{/isguest}}
                    {{/isloggedin}}
                </div>
            </nav>
        </div>
    </div>

    <!-- Offcanvas Mobile Menu (utilisé seulement pour visiteurs/invités) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="campusMobileMenu" aria-labelledby="campusMobileMenuLabel">
        <div class="offcanvas-header">
            <h5 class="mb-0" id="campusMobileMenuLabel">{{#str}}mobilemenu_title, theme_edly{{/str}}</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                    aria-label="{{#str}}mobilemenu_close_aria, theme_edly{{/str}}"></button>
        </div>

        <div class="offcanvas-body">
            {{#isloggedin}}
                {{^isguest}}
                    {{> theme_edly/customer_navigation_mobile }}
                {{/isguest}}
            {{/isloggedin}}

            {{#isloggedin}}
                {{^isguest}}{{! customer navigation already rendered above }}{{/isguest}}
            {{/isloggedin}}

            {{# header_search_bar }}
                <div class="mb-3">
                    {{{ edly_globalsearch_navbar }}}
                </div>
            {{/ header_search_bar }}

            <!-- Le menu principal est cloné ici en JS si présent -->
            <div id="mobilePrimaryMenuContainer" class="d-none">
                <hr class="my-3">
                <ul class="navbar-nav" id="mobilePrimaryMenu"></ul>
            </div>
        </div>
    </div>

</div>
<!-- End Navbar Area -->

{{> theme_boost/primary-drawer-mobile }}
