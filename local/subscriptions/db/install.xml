<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/subscriptions/db" VERSION="2026051010" COMMENT="XMLDB file for local_subscriptions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
		<TABLE NAME="user_subscription" COMMENT="Table storing user subscription data">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
				<FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="planid" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="pricepaid" TYPE="number" LENGTH="10,2" NOTNULL="false"/>
				<FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="false"/>
				<FIELD NAME="transactionid" TYPE="char" LENGTH="255" NOTNULL="false"/>
				<FIELD NAME="payment_provider" TYPE="char" LENGTH="50" NOTNULL="false"/>
				<FIELD NAME="start_date" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="end_date" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active"/>
				<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="false"/>
				<FIELD NAME="creation_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
				<FIELD NAME="provider_subscription_id" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false"/>
				<FIELD NAME="provider_customer_id" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false"/>
				<FIELD NAME="last_invoice_id" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false" COMMENT="Dernière facture Stripe traitée pour idempotence"/>
				<FIELD NAME="payment_failed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
				<FIELD NAME="last_payment_failed_at" TYPE="int" LENGTH="10" NOTNULL="false"/>
				<FIELD NAME="last_payment_failed_reason" TYPE="char" LENGTH="255" NOTNULL="false"/>
				<FIELD NAME="discount_percent" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" COMMENT="Réduction % appliquée au moment de l’achat"/>
				<FIELD NAME="discount_reason" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Raison de la réduction (ex: trial72h)"/>
				<FIELD NAME="discount_amount" TYPE="number" LENGTH="12" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" COMMENT="Montant de remise appliqué (dans la devise de la souscription)"/>
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
				<KEY NAME="user_idx" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
			</KEYS>
			<INDEXES>
				<INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
				<INDEX NAME="idx_us_provider_sub" UNIQUE="false" FIELDS="provider_subscription_id"/>
				<INDEX NAME="idx_us_last_invoice" UNIQUE="false" FIELDS="last_invoice_id"/>
			</INDEXES>
		</TABLE>
        
        <TABLE NAME="subscription_access_scope" COMMENT="Defines access scopes, i.e. sets of courses">
		  <FIELDS>
			<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
			<FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" />
			<FIELD NAME="course_ids" TYPE="text" NOTNULL="true" />
			<FIELD NAME="creation_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
		  </FIELDS>
		  <KEYS>
			<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
			<KEY NAME="name_unique" TYPE="unique" FIELDS="name"/>
		  </KEYS>
		</TABLE>
	
		<TABLE NAME="subscription_plan" COMMENT="Defines plans for subscribing to access scopes">
		  <FIELDS>
			<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
			<FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" />
			<FIELD NAME="access_scope_id" TYPE="int" LENGTH="10" NOTNULL="true" />
			<FIELD NAME="duration_key" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="1month" />
			<FIELD NAME="is_active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" />
			<FIELD NAME="creation_date" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="highlight_type" TYPE="char" LENGTH="20" NOTNULL="false" />
			<FIELD NAME="is_recurring" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1=abonnement (renouvellement auto), 0=paiement ponctuel"/>
			<FIELD NAME="is_trial" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1 = plan d’essai 7 jours"/>
			<FIELD NAME="expiry_reminder_days" TYPE="char" LENGTH="64" NOTNULL="false" COMMENT="Liste J-X propre au plan, ex: 14,7,3,1"/>
			<FIELD NAME="expiry_reminder_enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" COMMENT="1=actif, 0=désactivé pour ce plan"/>
		  </FIELDS>
		  <KEYS>
			<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
			<KEY NAME="access_scope_fk" TYPE="foreign" FIELDS="access_scope_id" REFTABLE="subscription_access_scope" REFFIELDS="id"/>
		  </KEYS>
			<INDEXES>
				<INDEX NAME="uniq_plan_name" UNIQUE="true" FIELDS="name"/>
			</INDEXES>
		</TABLE>
	
		<TABLE NAME="subscription_plan_price" COMMENT="Price for each plan in multiple currencies">
		  <FIELDS>
			<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" />
			<FIELD NAME="plan_id" TYPE="int" LENGTH="10" NOTNULL="true" />
			<FIELD NAME="currency" TYPE="char" LENGTH="10" NOTNULL="true" />
			<FIELD NAME="price" TYPE="number" LENGTH="10, 2" NOTNULL="true" SEQUENCE="false" DEFAULT="0.00"/>
			<FIELD NAME="stripe_price_id" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false" COMMENT="ID Stripe du prix (pour les abonnements)"/>
		  </FIELDS>
		  <KEYS>
			<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
			<KEY NAME="plan_fk" TYPE="foreign" FIELDS="plan_id" REFTABLE="subscription_plan" REFFIELDS="id"/>
			<KEY NAME="plan_currency_unique" TYPE="unique" FIELDS="plan_id,currency"/>
		  </KEYS>
		</TABLE>
        
		<TABLE NAME="subscription_access_scope_translation" COMMENT="Traductions des noms et descriptions des scopes">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
				<FIELD NAME="scope_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="lang" TYPE="char" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="name" TYPE="text" NOTNULL="true"/>
				<FIELD NAME="description" TYPE="text" NOTNULL="false"/>
				<FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Format of description; 1=FORMAT_HTML"/>
				<FIELD NAME="creation_date" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
				<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
				<KEY NAME="scopefk" TYPE="foreign" FIELDS="scope_id" REFTABLE="subscription_access_scope" REFFIELDS="id"/>
			</KEYS>
			<INDEXES>
				<INDEX NAME="lang_scope_unique" UNIQUE="true" FIELDS="scope_id, lang"/>
			</INDEXES>
		</TABLE>
		
		<TABLE NAME="subscription_plan_translation" COMMENT="Stores translations for subscription plans.">
			<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
			<FIELD NAME="plan_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="lang" TYPE="char" LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="name" TYPE="text" NOTNULL="true"/>
			<FIELD NAME="description" TYPE="text" NOTNULL="false"/>
			<FIELD NAME="descriptionformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Format of description; 1=FORMAT_HTML"/>
			<FIELD NAME="creation_date" TYPE="int" LENGTH="10" NOTNULL="false"/>
			<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="false"/>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
				<KEY NAME="plan_id_fk" TYPE="foreign" FIELDS="plan_id" REFTABLE="subscription_plan" REFFIELDS="id"/>
			</KEYS>
			<INDEXES>
				<INDEX NAME="lang_plan_unique" UNIQUE="true" FIELDS="plan_id, lang"/>
			</INDEXES>
		</TABLE>

		<TABLE NAME="subscription_payment_request">
			<FIELD NAME="id" TYPE="int" LENGTH="10" UNSIGNED="true" NOTNULL="true" DEFAULT="auto_increment"/>
			<FIELD NAME="planid"         TYPE="int"    LENGTH="10" NOTNULL="false" />
        	<FIELD NAME="userid"         TYPE="int"    LENGTH="10" NOTNULL="false" />
        	<FIELD NAME="email"          TYPE="char"   LENGTH="255" NOTNULL="false" />
        	<FIELD NAME="firstname"      TYPE="char"   LENGTH="100" NOTNULL="false" />
        	<FIELD NAME="lastname"       TYPE="char"   LENGTH="100" NOTNULL="false" />
			<FIELD NAME="phone" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Guest/checkout phone number"/>
			<FIELD NAME="phone_country" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="ISO country code for phone"/>
			<FIELD NAME="subscriptionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="currency" TYPE="char" LENGTH="10" UNSIGNED="false" NOTNULL="true"/>
			<FIELD NAME="price" TYPE="number" LENGTH="10,2" UNSIGNED="false" NOTNULL="true"/>
			<FIELD NAME="amount_minor" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Montant final payé en unités minor (ex: cents)"/>
			<FIELD NAME="created_ip" TYPE="char" LENGTH="45" NOTNULL="false" SEQUENCE="false" COMMENT="IPv4/IPv6 at creation"/>
			<FIELD NAME="created_useragent" TYPE="text" LENGTH="small" NOTNULL="false" SEQUENCE="false" COMMENT="HTTP User-Agent at creation"/>
			<FIELD NAME="accept_language" TYPE="char" LENGTH="191" NOTNULL="false" SEQUENCE="false" COMMENT="HTTP Accept-Language header"/>
			<FIELD NAME="http_referer" TYPE="text" LENGTH="small" NOTNULL="false" SEQUENCE="false" COMMENT="HTTP Referer at creation"/>
			<FIELD NAME="payment_provider" TYPE="char" LENGTH="50" UNSIGNED="false" NOTNULL="true"/>
			<FIELD NAME="sessionid"      TYPE="char"   LENGTH="255" NOTNULL="false" />
			<FIELD NAME="status" TYPE="char" LENGTH="20" UNSIGNED="false" NOTNULL="true" DEFAULT="pending"/>
			<FIELD NAME="transactionid" TYPE="char" LENGTH="255" UNSIGNED="false" NOTNULL="false"/>
			<FIELD NAME="payment_link" TYPE="text" LENGTH="" UNSIGNED="false" NOTNULL="false"/>
			<FIELD NAME="response_json" TYPE="text" LENGTH="" UNSIGNED="false" NOTNULL="false"/>
			<FIELD NAME="creation_date" TYPE="int" LENGTH="10" UNSIGNED="true" NOTNULL="true"/>
			<FIELD NAME="last_update" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="payment_date" TYPE="int" LENGTH="10" UNSIGNED="true" NOTNULL="false"/>
			<FIELD NAME="expiration_date" TYPE="int" LENGTH="10" NOTNULL="false"/>
			<FIELD NAME="emailsent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="attempts" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="last_attempt" TYPE="int" LENGTH="10" NOTNULL="false" />
			<FIELD NAME="last_error" TYPE="text" LENGTH="" NOTNULL="false" />
			<FIELD NAME="retry_token" TYPE="char" LENGTH="64" NOTNULL="false" />
			<FIELD NAME="retry_expires" TYPE="int" LENGTH="10" NOTNULL="false" />
			<FIELD NAME="reminder_stage" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" />
			<FIELD NAME="reminder1_at" TYPE="int" LENGTH="10" NOTNULL="false" />
			<FIELD NAME="reminder2_at" TYPE="int" LENGTH="10" NOTNULL="false" />
			<FIELD NAME="login_token" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="Jeton de connexion à usage unique après paiement"/>
			<FIELD NAME="login_token_expires" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Expiration du jeton (timestamp Unix)"/>
			<FIELD NAME="operation" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="purchase_new|extend_now|queue_future|upgrade_prorata"/>
			<FIELD NAME="reference_subscription_id" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Souscription impactée (si pertinent)"/>
			<FIELD NAME="locked_list_price" TYPE="number" LENGTH="12" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" COMMENT="Prix catalogue verrouillé (au checkout)"/>
			<FIELD NAME="locked_discount_percent" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" COMMENT="Remise % verrouillée"/>
			<FIELD NAME="locked_discount_amount" TYPE="number" LENGTH="12" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" COMMENT="Remise € verrouillée"/>
			<FIELD NAME="locked_discount_reason" TYPE="char" LENGTH="255" NOTNULL="false" COMMENT="Raison de la remise (ex: trial72h)"/>
			<FIELD NAME="locked_final_price" TYPE="number" LENGTH="12" DECIMALS="2" NOTNULL="true" DEFAULT="0.00" COMMENT="Montant final facturé (verrouillé)"/>
			<FIELD NAME="locked_at" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Timestamp du verrouillage"/>
			<KEYS>
				<KEY NAME="subscriptionid" TYPE="foreign" FIELDS="subscriptionid" REFTABLE="user_subscription" REFFIELDS="id"/>
				<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
			</KEYS>
			<INDEXES>
				<INDEX NAME="idx_spr_sessionid" UNIQUE="false" FIELDS="sessionid"/>
				<INDEX NAME="idx_spr_planid"    UNIQUE="false" FIELDS="planid"/>
				<INDEX NAME="idx_spr_userid"    UNIQUE="false" FIELDS="userid"/>
				<INDEX NAME="idx_spr_status"    UNIQUE="false" FIELDS="status"/>
				<INDEX NAME="idx_spr_operation" UNIQUE="false" FIELDS="operation"/>
				<INDEX NAME="idx_spr_refsubid" UNIQUE="false" FIELDS="reference_subscription_id"/>
			</INDEXES>
		</TABLE>  

		<TABLE NAME="subscription_reminder_log" COMMENT="Reminders sent for expiring subscriptions">
			<FIELDS>
				<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
				<FIELD NAME="subscriptionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
				<FIELD NAME="remind_key" TYPE="char" LENGTH="8" NOTNULL="true" COMMENT="d30/d7/d1"/>
				<FIELD NAME="sent_at" TYPE="int" LENGTH="10" NOTNULL="true"/>
			</FIELDS>
			<KEYS>
				<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
				<KEY NAME="uniq_sub_key" TYPE="unique" FIELDS="subscriptionid,remind_key"/>
			</KEYS>
		</TABLE>

		<TABLE NAME="subscription_event" COMMENT="Audit log of subscription-related events (webhooks, state changes)">
		<FIELDS>
			<FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
			<FIELD NAME="subscriptionid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="mdl_user_subscription.id"/>
			<FIELD NAME="eventtype" TYPE="char" LENGTH="32" NOTNULL="true" COMMENT="e.g. invoice_failed, invoice_paid, subscription_canceled"/>
			<FIELD NAME="provider_event_id" TYPE="char" LENGTH="64" NOTNULL="false" COMMENT="Stripe event or invoice id"/>
			<FIELD NAME="occurred_at" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp"/>
			<FIELD NAME="payload_json" TYPE="text" LENGTH="big" NOTNULL="false" COMMENT="Raw event metadata (JSON)"/>
		</FIELDS>
		<KEYS>
			<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
		</KEYS>
		</TABLE>

		<!-- Journal des réponses envoyées depuis quickreply.php -->
		<TABLE NAME="local_subs_contact_reply" COMMENT="Contact replies sent from quickreply.php (admin)">
		<FIELDS>
			<FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
			<FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="adminid"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="messageid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
			<FIELD NAME="toemail"     TYPE="char" LENGTH="255" NOTNULL="false"/>
			<FIELD NAME="toname"      TYPE="char" LENGTH="255" NOTNULL="false"/>
			<FIELD NAME="lang"        TYPE="char" LENGTH="20"  NOTNULL="false"/>
			<FIELD NAME="subject"     TYPE="char" LENGTH="255" NOTNULL="false"/>
			<FIELD NAME="bodyhtml"    TYPE="text"               NOTNULL="false"/>
			<FIELD NAME="bodytext"    TYPE="text"               NOTNULL="false"/>
			<FIELD NAME="ip"          TYPE="char" LENGTH="64"   NOTNULL="false"/>
		</FIELDS>
		<KEYS>
			<KEY NAME="primary" TYPE="primary" FIELDS="id"/>
		</KEYS>
		<INDEXES>
			<INDEX NAME="idx_time"   UNIQUE="false" FIELDS="timecreated"/>
			<INDEX NAME="idx_admin"  UNIQUE="false" FIELDS="adminid"/>
			<INDEX NAME="idx_msgid"  UNIQUE="false" FIELDS="messageid"/>
		</INDEXES>
		</TABLE>


