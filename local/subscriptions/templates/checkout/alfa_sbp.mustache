<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 520px;">
        <div class="card-body p-4 p-lg-5 text-center">
            <h1 class="h3 mb-2">{{title}}</h1>
            <p class="text-muted mb-4">{{description}}</p>
            {{#qr}}
                <img src="{{qr}}" alt="SBP QR" class="img-fluid mb-4" style="max-width: 320px;">
            {{/qr}}
            <div class="d-grid gap-2">
                {{#payload}}<a class="btn btn-primary btn-lg" href="{{payload}}">{{openbanklabel}}</a>{{/payload}}
                <a class="btn btn-outline-secondary" href="{{returnurl}}">{{verifylabel}}</a>
            </div>
        </div>
    </div>
</div>
