{{#hasdirectpurchase}}
    <div class="alert alert-primary d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" role="status" data-direct-purchase-resume>
        <div>
            <div class="fw-semibold">{{directpurchaseresumetitle}}</div>
            <div class="small mt-1">{{directpurchaseresumetext}}</div>
        </div>
        <a href="{{directpurchaseresumeurl}}" class="btn btn-primary flex-shrink-0">
            <i class="fa-solid fa-arrow-right-to-bracket me-2" aria-hidden="true"></i>{{directpurchaseresumelabel}}
        </a>
    </div>
{{/hasdirectpurchase}}
