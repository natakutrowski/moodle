{{#showaddedmodal}}
<div class="commerce-cart-feedback" role="dialog" aria-modal="true" aria-labelledby="commerce-cart-feedback-title">
    <a class="commerce-cart-feedback__backdrop" href="{{continueurl}}" aria-label="{{continuelabel}}"></a>
    <section class="commerce-cart-feedback__dialog card border-0 shadow-lg">
        <div class="card-body p-4">
            <div class="d-flex gap-3 align-items-start">
                <div class="commerce-cart-feedback__visual" aria-hidden="true">
                    {{#addedproducthascover}}<img src="{{addedproductcoverurl}}" alt="">{{/addedproducthascover}}
                    {{^addedproducthascover}}<span>✓</span>{{/addedproducthascover}}
                </div>
                <div class="flex-grow-1">
                    <h2 id="commerce-cart-feedback-title" class="h4 mb-2">{{addedmodaltitle}}</h2>
                    {{#addedproductname}}<p class="fw-semibold mb-1">{{addedproductname}}</p>{{/addedproductname}}
                    <p class="text-muted mb-0">{{addedmodaltext}}</p>
                </div>
                <a href="{{continueurl}}" class="btn-close" aria-label="{{continuelabel}}"></a>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                <a href="{{continueurl}}" class="btn btn-outline-secondary flex-grow-1">{{continuelabel}}</a>
                <a href="{{carturl}}" class="btn btn-primary flex-grow-1">{{viewcartlabel}}</a>
            </div>
        </div>
    </section>
</div>
{{/showaddedmodal}}
