<div class="commerce-storefront commerce-product-page commerce-product-page--course commerce-product-page--{{theme}} container py-4 py-lg-5">
    {{#showproducthero}}
    <header class="commerce-product-course-hero">
        <div class="commerce-product-course-hero__grid">
            <div class="commerce-product-course-hero__visual">
                {{> local_subscriptions/storefront/product_main_visual }}
            </div>
            <div class="commerce-product-course-hero__summary">
                <span class="badge rounded-pill commerce-product-type-badge mb-3">{{typelabel}}</span>
                <h1 class="commerce-product-course-hero__title">{{name}}</h1>
                {{#shortdescription}}
                    <div class="commerce-product-course-hero__description">{{{shortdescription}}}</div>
                {{/shortdescription}}

                {{#hasquickfacts}}
                    <div class="commerce-product-course-facts" aria-label="{{name}}">
                        {{#quickfacts}}
                            <span class="commerce-product-course-fact">
                                <strong>{{value}}</strong>
                                <span>{{label}}</span>
                            </span>
                        {{/quickfacts}}
                    </div>
                {{/hasquickfacts}}

                {{#commerceinhero}}
                    <div class="commerce-product-commerce-slot commerce-product-commerce-slot--hero commerce-product-course-commerce">
                        {{> local_subscriptions/storefront/product_commerce_panel }}
                    </div>
                {{/commerceinhero}}
                {{#commerceissidebar}}
                    <div class="commerce-product-commerce-slot commerce-product-course-commerce">
                        {{> local_subscriptions/storefront/product_commerce_panel }}
                    </div>
                {{/commerceissidebar}}
            </div>
        </div>
    </header>
    {{/showproducthero}}

    {{#commercebelowhero}}
        <div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide commerce-product-course-commerce commerce-product-course-commerce--standalone">
            {{> local_subscriptions/storefront/product_commerce_panel }}
        </div>
    {{/commercebelowhero}}

    <main class="commerce-product-sections commerce-product-course-sections">
        {{> local_subscriptions/storefront/product_intro_sections }}
        {{#commerceafterintro}}
            <div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide commerce-product-course-commerce">
                {{> local_subscriptions/storefront/product_commerce_panel }}
            </div>
        {{/commerceafterintro}}
        {{> local_subscriptions/storefront/product_remaining_sections }}
    </main>

    {{^showproducthero}}
        {{#commerceissidebar}}
            <div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide commerce-product-course-commerce commerce-product-course-commerce--standalone">
                {{> local_subscriptions/storefront/product_commerce_panel }}
            </div>
        {{/commerceissidebar}}
    {{/showproducthero}}

    {{#commercepagebottom}}
        <div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide commerce-product-course-commerce commerce-product-course-commerce--standalone">
            {{> local_subscriptions/storefront/product_commerce_panel }}
        </div>
    {{/commercepagebottom}}
</div>
{{> local_subscriptions/storefront/product_recommendations }}
{{> local_subscriptions/storefront/cart_added_modal }}
