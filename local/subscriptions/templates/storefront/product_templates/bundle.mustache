<div class="commerce-storefront commerce-product-page commerce-product-page--bundle commerce-product-page--{{theme}} container py-4 py-lg-5">
    {{#showproducthero}}
    <header class="commerce-product-bundle-hero">
        <div class="commerce-product-bundle-hero__grid">
            <div class="commerce-product-bundle-hero__visual">
                {{> local_subscriptions/storefront/product_main_visual }}
            </div>

            <div class="commerce-product-bundle-hero__summary">
                <h1 class="commerce-product-bundle-hero__title">{{name}}</h1>

                {{#shortdescription}}
                <div class="commerce-product-bundle-hero__description">{{{shortdescription}}}</div>
                {{/shortdescription}}

                {{#hasbundlecomponents}}
                <div class="commerce-product-bundle-includes">
                    <div class="commerce-product-bundle-includes__label">{{bundleincludeslabel}}</div>
                    <div class="commerce-product-bundle-includes__grid">
                        {{#bundlecomponents}}
                        <article class="commerce-product-bundle-component">
                            <h2>{{name}}</h2>
                            {{#description}}<div>{{{description}}}</div>{{/description}}
                        </article>
                        {{/bundlecomponents}}
                    </div>
                </div>
                {{/hasbundlecomponents}}

                {{#commerceinhero}}
                <div class="commerce-product-bundle-commerce">
                    {{> local_subscriptions/storefront/product_commerce_panel }}
                </div>
                {{/commerceinhero}}
            </div>
        </div>
    </header>
    {{/showproducthero}}

    {{#commercebelowhero}}
    <div class="commerce-product-bundle-commerce commerce-product-bundle-commerce--standalone">
        {{> local_subscriptions/storefront/product_commerce_panel }}
    </div>
    {{/commercebelowhero}}

    {{#hassections}}
    <main class="commerce-product-bundle-sections">
        {{> local_subscriptions/storefront/product_intro_sections }}
        {{#commerceafterintro}}
        <div class="commerce-product-bundle-commerce commerce-product-bundle-commerce--standalone">
            {{> local_subscriptions/storefront/product_commerce_panel }}
        </div>
        {{/commerceafterintro}}
        {{> local_subscriptions/storefront/product_remaining_sections }}
    </main>
    {{/hassections}}

    {{#commerceissidebar}}
    <div class="commerce-product-bundle-commerce commerce-product-bundle-commerce--standalone">
        {{> local_subscriptions/storefront/product_commerce_panel }}
    </div>
    {{/commerceissidebar}}

    {{#commercepagebottom}}
    <div class="commerce-product-bundle-commerce commerce-product-bundle-commerce--standalone">
        {{> local_subscriptions/storefront/product_commerce_panel }}
    </div>
    {{/commercepagebottom}}
</div>

{{> local_subscriptions/storefront/product_recommendations }}
{{> local_subscriptions/storefront/cart_added_modal }}
