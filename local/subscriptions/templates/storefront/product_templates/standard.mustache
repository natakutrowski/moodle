<div class="commerce-storefront commerce-product-page commerce-product-page--standard commerce-product-page--{{theme}} container py-4 py-lg-5">
    {{#showproducthero}}
    <div class="row g-5 align-items-start">
        <div class="col-lg-5">{{> local_subscriptions/storefront/product_main_visual }}</div>
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-light border commerce-product-type-badge mb-3">{{typelabel}}</span>
            <h1 class="display-5 fw-bold mb-3">{{name}}</h1>
            <div class="lead text-muted mb-4">{{{shortdescription}}}</div>
            {{#commerceinhero}}<div class="commerce-product-commerce-slot commerce-product-commerce-slot--hero">{{> local_subscriptions/storefront/product_commerce_panel }}</div>{{/commerceinhero}}
            {{#commerceissidebar}}<div class="commerce-product-commerce-slot commerce-product-commerce-slot--sticky">{{> local_subscriptions/storefront/product_commerce_panel }}</div>{{/commerceissidebar}}
        </div>
    </div>
    {{/showproducthero}}
    {{#commercebelowhero}}<div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide mt-4">{{> local_subscriptions/storefront/product_commerce_panel }}</div>{{/commercebelowhero}}
    <div class="commerce-product-sections mt-5 pt-lg-4">
        {{> local_subscriptions/storefront/product_intro_sections }}
        {{#commerceafterintro}}<div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide my-4">{{> local_subscriptions/storefront/product_commerce_panel }}</div>{{/commerceafterintro}}
        {{> local_subscriptions/storefront/product_remaining_sections }}
    </div>
    {{#commercepagebottom}}<div class="commerce-product-commerce-slot commerce-product-commerce-slot--wide mt-5">{{> local_subscriptions/storefront/product_commerce_panel }}</div>{{/commercepagebottom}}
</div>
{{> local_subscriptions/storefront/product_recommendations }}
{{> local_subscriptions/storefront/cart_added_modal }}
