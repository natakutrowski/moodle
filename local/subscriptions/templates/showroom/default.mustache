<main class="commerce-showroom {{#showexpeditiontheme}}commerce-showroom--expedition{{/showexpeditiontheme}}{{^showexpeditiontheme}}commerce-showroom--generic{{/showexpeditiontheme}}" data-showroom="{{showroomkey}}" data-showroom-production-ready>
    <a class="commerce-showroom-skip-link" href="#showroom-main-content">{{#str}}commerce_a11y_skip_to_content, local_subscriptions{{/str}}</a>
    <span id="showroom-main-content" tabindex="-1"></span>
        {{#showroomorderedblocks}}
{{#ishero}}
    <section class="commerce-showroom-hero {{herolayoutclass}} commerce-showroom-hero--{{herovariant}} commerce-showroom-media--{{heromediaposition}} {{#hasherobackground}}has-cms-background{{/hasherobackground}}" id="showroom-top" data-hero-status="{{herostatus}}" style="--showroom-section-custom-background: {{herolayoutbackgroundcolor}}; --showroom-hero-bg-opacity: {{herolayoutbackgroundopacity}}%; --showroom-hero-bg-blur: {{herolayoutbackgroundblur}}px; {{#hasherobackground}}--showroom-hero-background: url('{{herobackgroundurl}}');{{/hasherobackground}}">
        {{#hasherolayoutbackgroundimage}}<span class="commerce-showroom-common-background" aria-hidden="true" style="--showroom-common-bg-opacity: {{herolayoutbackgroundopacity}}%; --showroom-common-bg-blur: {{herolayoutbackgroundblur}}px;"><img src="{{herolayoutbackgroundimageurl}}" alt="" loading="lazy" decoding="async"></span>{{/hasherolayoutbackgroundimage}}
        {{#showexpeditiontheme}}
        <div class="commerce-showroom-hero__sky" aria-hidden="true"></div>
        <div class="commerce-showroom-hero__cloud commerce-showroom-hero__cloud--one" aria-hidden="true"></div>
        <div class="commerce-showroom-hero__cloud commerce-showroom-hero__cloud--two" aria-hidden="true"></div>
        <div class="commerce-showroom-hero__light" aria-hidden="true"></div>
        <div class="commerce-showroom-hero__mountain commerce-showroom-hero__mountain--back" aria-hidden="true"></div>
        <div class="commerce-showroom-hero__mountain commerce-showroom-hero__mountain--front" aria-hidden="true"></div>
        {{/showexpeditiontheme}}
        <div class="commerce-showroom-container commerce-showroom-hero__inner">
            {{#showexpeditiontheme}}
            <div class="commerce-showroom-hero__expedition commerce-showroom-hero__expedition--top" data-showroom-reveal>
                <span><i class="{{expeditionicon}}" aria-hidden="true"></i>{{heroexpeditionlabel}}</span>
                <span>{{herostagelabel}}</span>
            </div>
            {{/showexpeditiontheme}}
            {{#heroislavendera1}}
            <div class="commerce-showroom-hero__a1-badges" aria-label="{{eyebrow}}">
                <span class="commerce-showroom-hero__a1-badge commerce-showroom-hero__a1-badge--primary">{{heroexpeditionlabel}}</span>
                <span class="commerce-showroom-hero__a1-badge commerce-showroom-hero__a1-badge--journey"><i class="fa-solid fa-sailboat" aria-hidden="true"></i>{{herostagelabel}}</span>
            </div>
            {{/heroislavendera1}}
            <div class="commerce-showroom-hero__grid">
                <div class="commerce-showroom-hero__copy" data-showroom-reveal>
                    <h1>
                        <span>{{title}}</span>
                        {{#hasherotitleaccent}}<span class="commerce-showroom-hero__title-accent">{{herotitleaccent}}</span>{{/hasherotitleaccent}}{{#hasherotitlesuffix}} <span class="commerce-showroom-hero__title-suffix">{{herotitlesuffix}}</span>{{/hasherotitlesuffix}}
                    </h1>
                    <div class="commerce-showroom-hero__lead">
                        {{#herodescriptionlines}}<p>{{text}}</p>{{/herodescriptionlines}}
                    </div>
                    <div class="commerce-showroom-hero__actions">
                        <a href="{{heroactionurl}}" class="commerce-showroom-btn commerce-showroom-btn--primary commerce-showroom-btn--hero" data-showroom-hero-action data-showroom-track="hero_cta">{{herocta}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        {{#showblockvideo}}
                        {{#showherosecondarycta}}
                            {{#videomodal}}
                            <button type="button" class="commerce-showroom-btn commerce-showroom-btn--glass" data-showroom-video-open data-showroom-track="video_open"><i class="fa-solid fa-circle-play" aria-hidden="true"></i>{{herosecondarycta}}</button>
                            {{/videomodal}}
                            {{^videomodal}}
                            <a href="#showroom-video" class="commerce-showroom-btn commerce-showroom-btn--glass" data-showroom-track="video_anchor"><i class="fa-solid fa-circle-play" aria-hidden="true"></i>{{herosecondarycta}}</a>
                            {{/videomodal}}
                        {{/showherosecondarycta}}
                        {{/showblockvideo}}
                    </div>
                    {{#heroislavendera1}}{{#hasherostartlabel}}
                        <p class="commerce-showroom-hero__a1-start"><i class="fa-regular fa-calendar" aria-hidden="true"></i>{{herostartlabel}}</p>
                    {{/hasherostartlabel}}{{/heroislavendera1}}
                </div>
                <div class="commerce-showroom-hero__visual {{#hasherodesktopimage}}has-a1-tablet{{/hasherodesktopimage}}" role="img" aria-label="{{#str}}commerce_a11y_showroom_devices, local_subscriptions{{/str}}" data-showroom-reveal>
                    <div class="commerce-showroom-orbit commerce-showroom-orbit--one" aria-hidden="true"></div>
                    <div class="commerce-showroom-orbit commerce-showroom-orbit--two" aria-hidden="true"></div>
                    <div class="commerce-showroom-device commerce-showroom-device--desktop {{#hasherodesktopimage}}has-cms-image{{/hasherodesktopimage}}">
                        <div class="commerce-showroom-device__bar"><span></span><span></span><span></span></div>
                        <div class="commerce-showroom-device__screen">
                            {{#hasherodesktopimage}}
                            <img class="commerce-showroom-device__cms-image commerce-showroom-device__cms-image--desktop"
                                 src="{{herodesktopimageurl}}"
                                 alt=""
                                 loading="eager"
                                 decoding="async">
                            {{/hasherodesktopimage}}
                            {{^hasherodesktopimage}}
                            <span class="commerce-showroom-device__stage">{{herodevicestage}}</span>
                            <div class="commerce-showroom-device__mountains"></div>
                            <div class="commerce-showroom-device__progress"><span></span></div>
                            <div class="commerce-showroom-device__quiz"><span></span><span></span><span></span></div>
                            {{/hasherodesktopimage}}
                        </div>
                    </div>
                    <div class="commerce-showroom-device commerce-showroom-device--mobile commerce-showroom-device--mobile-spaced {{#hasheromobileimage}}has-cms-image{{/hasheromobileimage}}">
                        <div class="commerce-showroom-device__notch"></div>
                        {{#hasheromobileimage}}
                        <img class="commerce-showroom-device__cms-image commerce-showroom-device__cms-image--mobile"
                             src="{{heromobileimageurl}}"
                             alt=""
                             loading="eager"
                             decoding="async">
                        {{/hasheromobileimage}}
                        {{^hasheromobileimage}}
                        <i class="{{heromobileicon}}" aria-hidden="true"></i><strong>{{heromobilevalue}}</strong><span>{{heromobilelabel}}</span>
                        {{/hasheromobileimage}}
                    </div>
                    {{#showherogustave}}
                    <div class="commerce-showroom-gustave" aria-hidden="true">
                        <span class="commerce-showroom-gustave__head"><i class="fa-solid fa-horse-head" aria-hidden="true"></i></span>
                        <span class="commerce-showroom-gustave__pack"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
                    </div>
                    {{/showherogustave}}
                </div>
            </div>
            {{#showblockstats}}
            {{#heroislavendera1}}
            <div class="commerce-showroom-hero__a1-stats" role="list" aria-label="{{#str}}commerce_a11y_key_figures, local_subscriptions{{/str}}">
                {{#heroa1statitems}}
                <article class="commerce-showroom-hero__a1-stat" role="listitem">
                    <span class="commerce-showroom-hero__a1-stat-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
                    <span class="commerce-showroom-hero__a1-stat-copy"><strong>{{value}}</strong><small>{{label}}</small></span>
                </article>
                {{/heroa1statitems}}
            </div>
            {{/heroislavendera1}}
            {{^heroislavendera1}}
            <div class="commerce-showroom-hero__stats commerce-showroom-hero__stats--{{statslayout}} {{#hasherostat5}}commerce-showroom-hero__stats--five{{/hasherostat5}}" role="list" aria-label="{{#str}}commerce_a11y_key_figures, local_subscriptions{{/str}}">
                <div role="listitem"><strong {{#statsanimate}}data-showroom-counter data-counter-value="{{herostat1value}}"{{/statsanimate}}>{{herostat1value}}</strong><span>{{herostat1label}}</span></div>
                <div role="listitem"><strong {{#statsanimate}}data-showroom-counter data-counter-value="{{herostat2value}}"{{/statsanimate}}>{{herostat2value}}</strong><span>{{herostat2label}}</span></div>
                <div role="listitem"><strong {{#statsanimate}}data-showroom-counter data-counter-value="{{herostat3value}}"{{/statsanimate}}>{{herostat3value}}</strong><span>{{herostat3label}}</span></div>
                <div role="listitem"><strong {{#statsanimate}}data-showroom-counter data-counter-value="{{herostat4value}}"{{/statsanimate}}>{{herostat4value}}</strong><span>{{herostat4label}}</span></div>
                {{#hasherostat5}}<div role="listitem"><strong {{#statsanimate}}data-showroom-counter data-counter-value="{{herostat5value}}"{{/statsanimate}}>{{herostat5value}}</strong><span>{{herostat5label}}</span></div>{{/hasherostat5}}
            </div>
            {{/heroislavendera1}}
            {{/showblockstats}}
        </div>
    </section>
    {{/ishero}}

    {{#isanchornav}}{{> local_subscriptions/showroom/block_anchor_nav }}{{/isanchornav}}
    {{#isadventureoverview}}{{> local_subscriptions/showroom/block_adventure_overview }}{{/isadventureoverview}}
    {{#iscommunityclan}}{{> local_subscriptions/showroom/block_community_clan }}{{/iscommunityclan}}
    {{#istutorchat}}{{> local_subscriptions/showroom/block_tutor_chat }}{{/istutorchat}}
    {{#iscurriculumtabs}}{{> local_subscriptions/showroom/block_curriculum_tabs }}{{/iscurriculumtabs}}
    {{#isjourneymap}}{{> local_subscriptions/showroom/block_journey_map }}{{/isjourneymap}}
    {{#ispreparationflow}}{{> local_subscriptions/showroom/block_preparation_flow }}{{/ispreparationflow}}

    {{#isproblem}}
    <section id="showroom-problem" class="commerce-showroom-section commerce-showroom-section--soft commerce-showroom-problem {{problemlayoutclass}}" style="--showroom-section-custom-background: {{problemlayoutbackgroundcolor}};">
        {{#hasproblemlayoutbackgroundimage}}<span class="commerce-showroom-common-background" aria-hidden="true" style="--showroom-common-bg-opacity: {{problemlayoutbackgroundopacity}}%; --showroom-common-bg-blur: {{problemlayoutbackgroundblur}}px;"><img src="{{problemlayoutbackgroundimageurl}}" alt="" loading="lazy" decoding="async"></span>{{/hasproblemlayoutbackgroundimage}}
        <div class="commerce-showroom-container">
            <div class="commerce-showroom-problem__heading">
                <p class="commerce-showroom-problem__badge">
                    <i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i>
                    {{problemeyebrow}}
                </p>
                <h2>
                    {{problemtitle}}
                    {{#problemtitleaccent}}<span>{{problemtitleaccent}}</span>{{/problemtitleaccent}}
                </h2>
                <p>
                    {{#problemdescriptionlines}}<span>{{text}}</span>{{/problemdescriptionlines}}
                </p>
            </div>

            <div class="commerce-showroom-problem-grid">
                {{#problems}}
                    <article class="commerce-showroom-mini-card commerce-showroom-problem-card">
                        <span class="commerce-showroom-icon commerce-showroom-problem-card__icon">
                            <i class="{{icon}}" aria-hidden="true"></i>
                        </span>
                        <h3>{{title}}</h3>
                        <p>{{text}}</p>
                    </article>
                {{/problems}}
            </div>

            {{#hasproblemsolution}}
            <div class="commerce-showroom-problem__solution">
                <span class="commerce-showroom-problem__solution-icon">
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                </span>
                <div>
                    <strong>
                        {{problemsolutiontitle}}{{#problemsolutiontitleaccent}} <span class="commerce-showroom-problem__solution-accent">{{problemsolutiontitleaccent}}</span>{{/problemsolutiontitleaccent}}
                    </strong>
					<p>
					    {{problemsolutiontext}}
					    {{#problemsolutiontextaccent}} <span class="commerce-showroom-problem__solution-accent">{{problemsolutiontextaccent}}</span>{{/problemsolutiontextaccent}}
					    {{problemsolutiontextmiddle}}
					    {{#problemsolutiontextaccent2}} <span class="commerce-showroom-problem__solution-accent">{{problemsolutiontextaccent2}}</span>{{/problemsolutiontextaccent2}}
					</p>
                </div>
            </div>
            {{/hasproblemsolution}}
        </div>
    </section>
    {{/isproblem}}


    {{#isprobleminteractive}}
    <section id="showroom-problem-interactive" class="commerce-showroom-section commerce-showroom-interactive-problem {{interactiveproblemvariantclass}} {{probleminteractivelayoutclass}}" data-showroom-interactive-problem data-problem-presentation="{{interactiveproblempresentation}}" data-correct-answer="{{interactiveproblemcorrectanswer}}" style="--showroom-section-custom-background: {{probleminteractivelayoutbackgroundcolor}};">
        {{#hasprobleminteractivelayoutbackgroundimage}}<span class="commerce-showroom-common-background" aria-hidden="true" style="--showroom-common-bg-opacity: {{probleminteractivelayoutbackgroundopacity}}%; --showroom-common-bg-blur: {{probleminteractivelayoutbackgroundblur}}px;"><img src="{{probleminteractivelayoutbackgroundimageurl}}" alt="" loading="lazy" decoding="async"></span>{{/hasprobleminteractivelayoutbackgroundimage}}
        <div class="commerce-showroom-container">
            <div class="commerce-showroom-interactive-problem__heading">
                <p class="commerce-showroom-interactive-problem__badge"><i class="fa-solid fa-circle-question" aria-hidden="true"></i>{{interactiveproblemeyebrow}}</p>
                <h2>{{interactiveproblemtitle}} <span>{{interactiveproblemtitleaccent}}</span></h2>
                <p>{{interactiveproblemtext}}</p>
            </div>

            {{#interactiveproblemisfourcolumnsppt}}
            <div class="commerce-showroom-interactive-problem__ppt-stage">
                <div class="commerce-showroom-interactive-problem__ppt-column commerce-showroom-interactive-problem__ppt-column--choices">
                    <h3>{{interactiveproblemcol1title}}</h3>
                    <div class="commerce-showroom-interactive-problem__ppt-choice-list">
                        {{#interactiveproblemcol1items}}
                        <div class="commerce-showroom-interactive-problem__ppt-choice">
                            <span aria-hidden="true">?</span>
                            <strong>{{text}}</strong>
                        </div>
                        {{/interactiveproblemcol1items}}
                    </div>
                    {{#interactiveproblemcol1footer}}
                    <p class="commerce-showroom-interactive-problem__ppt-footer">
                        <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                        <span>{{interactiveproblemcol1footer}}</span>
                    </p>
                    {{/interactiveproblemcol1footer}}
                </div>

                <div class="commerce-showroom-interactive-problem__ppt-column commerce-showroom-interactive-problem__ppt-column--question">
                    <h3>{{interactiveproblemcol2title}}</h3>
                    <div class="commerce-showroom-interactive-problem__ppt-question-stage">
                        <svg class="commerce-showroom-interactive-problem__ppt-arrows" viewBox="0 0 320 260" aria-hidden="true" focusable="false">
                            <path d="M 5 55 C 35 55, 55 85, 88 103"></path>
                            <polyline points="78,96 88,103 77,106"></polyline>
                            <path d="M 5 205 C 35 205, 55 170, 88 153"></path>
                            <polyline points="77,151 88,153 80,161"></polyline>
                            <path d="M 232 88 C 265 74, 286 58, 315 52"></path>
                            <polyline points="305,48 315,52 307,59"></polyline>
                            <path d="M 232 130 C 265 130, 287 130, 315 130"></path>
                            <polyline points="305,125 315,130 305,135"></polyline>
                            <path d="M 228 170 C 262 185, 286 205, 315 212"></path>
                            <polyline points="307,204 315,212 304,214"></polyline>
                        </svg>
                        <div class="commerce-showroom-interactive-problem__ppt-target" aria-hidden="true">
                            <span>{{interactiveproblemcol2centertext}}</span>
                        </div>
                    </div>
                    {{#interactiveproblemcol2subtext}}
                    <div class="commerce-showroom-interactive-problem__ppt-note">{{interactiveproblemcol2subtext}}</div>
                    {{/interactiveproblemcol2subtext}}
                </div>

                <div class="commerce-showroom-interactive-problem__ppt-column commerce-showroom-interactive-problem__ppt-column--examples">
                    <h3>{{interactiveproblemcol3title}}</h3>
                    <div class="commerce-showroom-interactive-problem__ppt-example-list">
                        {{#interactiveproblemcol3items}}
                        <div class="commerce-showroom-interactive-problem__ppt-example">{{text}}</div>
                        {{/interactiveproblemcol3items}}
                    </div>
                </div>

                <div class="commerce-showroom-interactive-problem__ppt-column commerce-showroom-interactive-problem__ppt-column--meaning">
                    <h3>{{interactiveproblemcol4title}}</h3>
                    <div class="commerce-showroom-interactive-problem__ppt-meaning-list">
                        {{#interactiveproblemcol4items}}
                        <div class="commerce-showroom-interactive-problem__ppt-meaning-item">
                            <span class="commerce-showroom-interactive-problem__ppt-meaning-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
                            <div>
                                <strong>{{title}}</strong>
                                <p>{{text}}</p>
                            </div>
                        </div>
                        {{/interactiveproblemcol4items}}
                    </div>
                </div>
            </div>

            <div class="commerce-showroom-interactive-problem__ppt-solution">
                <span class="commerce-showroom-interactive-problem__ppt-solution-icon" aria-hidden="true"><i class="fa-solid fa-compass"></i></span>
                <div>
                    <strong>
                        {{interactiveproblemsolutiontitle}}
                        {{#interactiveproblemsolutiontitleaccent}} <span>{{interactiveproblemsolutiontitleaccent}}</span>{{/interactiveproblemsolutiontitleaccent}}
                    </strong>
                    <p>
                        {{interactiveproblemsolutiontext}}
                        {{#interactiveproblemsolutiontextaccent}} <span>{{interactiveproblemsolutiontextaccent}}</span>{{/interactiveproblemsolutiontextaccent}}
                    </p>
                </div>
            </div>
            {{/interactiveproblemisfourcolumnsppt}}

            {{^interactiveproblemisfourcolumnsppt}}
            <div class="commerce-showroom-interactive-problem__stage">
                <svg class="commerce-showroom-interactive-problem__arrows"
                     data-interactive-problem-arrows
                     aria-hidden="true"
                     focusable="false"></svg>

                <div class="commerce-showroom-interactive-problem__choices">
                    <h3>{{interactiveproblemchoiceslabel}}</h3>
                    <div class="commerce-showroom-interactive-problem__choice-list">
                    {{#interactiveproblemchoices}}
                        <button type="button" class="commerce-showroom-interactive-problem__choice" draggable="true" data-problem-choice data-value="{{text}}" aria-label="{{text}}">
                            <span class="commerce-showroom-interactive-problem__choice-status" aria-hidden="true">?</span>
                            <strong>{{text}}</strong>
                            <span class="commerce-showroom-interactive-problem__drag-handle" aria-hidden="true">
                                <i></i><i></i><i></i><i></i><i></i><i></i>
                            </span>
                        </button>
                    {{/interactiveproblemchoices}}
                        <div class="commerce-showroom-interactive-problem__choice commerce-showroom-interactive-problem__choice--passive"
                             aria-hidden="true">
                            <span class="commerce-showroom-interactive-problem__choice-status">?</span>
                            <strong>...</strong>
                        </div>
                    </div>
                    {{#interactiveproblemdraghint}}
                    <p class="commerce-showroom-interactive-problem__drag-hint commerce-showroom-interactive-problem__drag-hint--desktop">
                        <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                        <span>{{interactiveproblemdraghint}}</span>
                    </p>
                    {{/interactiveproblemdraghint}}
                    {{#interactiveproblemtaphint}}
                    <p class="commerce-showroom-interactive-problem__drag-hint commerce-showroom-interactive-problem__drag-hint--mobile">
                        <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                        <span>{{interactiveproblemtaphint}}</span>
                    </p>
                    {{/interactiveproblemtaphint}}
                </div>
                <div class="commerce-showroom-interactive-problem__target-column">
                    <h3>{{interactiveproblemtargetlabel}}</h3>
                    <button type="button" class="commerce-showroom-interactive-problem__target" data-interactive-problem-target data-problem-target aria-live="polite">
                        <span class="commerce-showroom-interactive-problem__target-icon" data-problem-target-icon>?</span>
                    </button>
                    <strong class="commerce-showroom-interactive-problem__selected" data-problem-selected></strong>
                    <span class="commerce-showroom-interactive-problem__feedback" data-problem-feedback></span>
                    <div class="commerce-showroom-interactive-problem__mobile-arrow" aria-hidden="true">
                        <span></span>
                    </div>
                </div>
                <div class="commerce-showroom-interactive-problem__consequences" data-interactive-problem-consequences>
                    {{#interactiveproblemconsequences}}
                    <div class="commerce-showroom-interactive-problem__consequence">
                        <span class="commerce-showroom-interactive-problem__consequence-icon"
                              data-interactive-problem-cross
                              aria-hidden="true">×</span>
                        <p>{{text}}</p>
                    </div>
                    {{/interactiveproblemconsequences}}
                </div>
            </div>
            <div class="commerce-showroom-interactive-problem__solution">
                <span class="commerce-showroom-interactive-problem__solution-icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                <div>
                    <strong>
                        {{interactiveproblemsolutiontitle}}
                        {{#interactiveproblemsolutiontitleaccent}}<span class="commerce-showroom-interactive-problem__solution-accent">{{interactiveproblemsolutiontitleaccent}}</span>{{/interactiveproblemsolutiontitleaccent}}.
                    </strong>
                    <p>
                        {{interactiveproblemsolutiontext}}
                        {{#interactiveproblemsolutiontextaccent}}<span class="commerce-showroom-interactive-problem__solution-accent">{{interactiveproblemsolutiontextaccent}}</span>{{/interactiveproblemsolutiontextaccent}}.
                    </p>
                </div>
            </div>
            <span class="d-none" data-problem-success>{{interactiveproblemsuccessfeedback}}</span>
            <span class="d-none" data-problem-error>{{interactiveproblemerrorfeedback}}</span>
            {{/interactiveproblemisfourcolumnsppt}}
        </div>
    </section>
    {{/isprobleminteractive}}

    {{#islearningmethod}}
    <section id="showroom-learning-method" class="commerce-showroom-section commerce-showroom-driving-method {{learningmethodlayoutclass}}" style="--showroom-section-custom-background: {{learningmethodlayoutbackgroundcolor}};">
        {{#haslearningmethodlayoutbackgroundimage}}<span class="commerce-showroom-common-background" aria-hidden="true" style="--showroom-common-bg-opacity: {{learningmethodlayoutbackgroundopacity}}%; --showroom-common-bg-blur: {{learningmethodlayoutbackgroundblur}}px;"><img src="{{learningmethodlayoutbackgroundimageurl}}" alt="" loading="lazy" decoding="async"></span>{{/haslearningmethodlayoutbackgroundimage}}
        <div class="commerce-showroom-container">
            <header class="commerce-showroom-driving-method__heading">
                <p class="commerce-showroom-driving-method__badge">
                    <span class="commerce-showroom-driving-method__badge-wheel" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span>{{methodeyebrow}}</span>
                </p>
                <h2>{{methodtitle}}</h2>
                <div class="commerce-showroom-driving-method__subtitle">
                    <p>{{methodsubtitle}}</p>
                    <p class="commerce-showroom-driving-method__subtitle-accent">{{methodsubtitleaccent}}</p>
                </div>
                <div class="commerce-showroom-driving-method__intro">
                    {{#methodintrolines}}<p>{{text}}</p>{{/methodintrolines}}
                </div>
            </header>

            <div class="commerce-showroom-driving-method__stages">
                <svg class="commerce-showroom-driving-method__route" viewBox="-90 0 1380 170" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <path d="M-58 100 C70 42,245 145,395 88 S650 40,805 100 S1080 150,1270 72"></path>
                    <circle cx="-58" cy="100" r="5"></circle>
                    <circle cx="395" cy="88" r="5"></circle>
                    <circle cx="805" cy="100" r="5"></circle>
                    <path class="commerce-showroom-driving-method__route-flag" d="M1270 20 L1270 72 M1270 22 L1308 32 L1270 46"></path>
                </svg>

                <article class="commerce-showroom-driving-method__stage">
                    <div class="commerce-showroom-driving-method__stage-head"><span class="commerce-showroom-driving-method__number">01</span><h3>{{methodstage1title}}</h3></div>
                    <div class="commerce-showroom-driving-method__wheel-scene">
                        <div class="commerce-showroom-driving-method__wheel" aria-hidden="true">
                            <span class="commerce-showroom-driving-method__wheel-rim"></span>
                            <span class="commerce-showroom-driving-method__wheel-hub"></span>
                            <span class="commerce-showroom-driving-method__wheel-spoke commerce-showroom-driving-method__wheel-spoke--left"></span>
                            <span class="commerce-showroom-driving-method__wheel-spoke commerce-showroom-driving-method__wheel-spoke--right"></span>
                            <span class="commerce-showroom-driving-method__wheel-spoke commerce-showroom-driving-method__wheel-spoke--bottom"></span>
                        </div>
                        <div class="commerce-showroom-driving-method__thoughts">
                            {{#methodstage1items}}<span class="commerce-showroom-driving-method__thought">{{text}}</span>{{/methodstage1items}}
                        </div>
                    </div>
                    <p class="commerce-showroom-driving-method__stage-footer">{{methodstage1footer}}</p>
                </article>

                <article class="commerce-showroom-driving-method__stage">
