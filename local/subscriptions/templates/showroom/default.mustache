                    <span aria-hidden="true"></span>
                </p>
                {{/showfinaltext}}
                <a href="{{finalactionurl}}" data-showroom-track="final_cta" class="commerce-showroom-btn commerce-showroom-btn--{{finalstyle}}">{{finalcta}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                {{#hasfinalsecondarycta}}
                <a href="{{finalsecondarytarget}}" class="commerce-showroom-final__secondary-link">{{finalsecondarylabel}}</a>
                {{/hasfinalsecondarycta}}
                {{#hasfinalperks}}
                <div class="commerce-showroom-final__perks" aria-label="Highlights">
                    {{#finalperks}}
                    <span class="commerce-showroom-final__perk"><i class="{{icon}}" aria-hidden="true"></i><strong>{{title}}</strong></span>
                    {{/finalperks}}
                </div>
                {{/hasfinalperks}}
            </div>

            {{#showexpeditiontheme}}
            {{^isfinalctaarticle}}
            <aside class="commerce-showroom-expedition-card commerce-showroom-final__expedition" aria-label="{{expeditionlabel}}">
                <span class="commerce-showroom-expedition-card__icon"><i class="{{expeditionicon}}" aria-hidden="true"></i></span>
                <div><strong>{{expeditionlabel}}</strong><span>{{expeditionstage}}</span><small>{{expeditionaltitude}}</small></div>
            </aside>
            {{/isfinalctaarticle}}
            {{/showexpeditiontheme}}

            <div class="commerce-showroom-final__inline-mobile-cta" data-showroom-final-inline-mobile-cta>
                <label class="commerce-showroom-sticky-currency" aria-label="{{currencylabel}}">
                    <select data-showroom-currency-ajax>
                        {{#currencies}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/currencies}}
                    </select>
                </label>
                <a href="#showroom-offers" data-showroom-smart-anchor>
                    {{herocta}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <footer class="commerce-showroom-final__legal" data-showroom-final-legal>
            <div class="commerce-showroom-container commerce-showroom-final__legal-inner">
                <div class="commerce-showroom-final__company">
                    {{#finallegalshowname}}
                    <strong class="commerce-showroom-final__company-name"
                        data-showroom-legal-field="name" {{^hasfinallegalname}}hidden{{/hasfinallegalname}}>{{finallegalname}}</strong>
                    {{/finallegalshowname}}

                    {{#finallegalshowaddress}}
                    <span class="commerce-showroom-final__company-detail"
                        data-showroom-legal-field="address" {{^hasfinallegaladdress}}hidden{{/hasfinallegaladdress}}>{{finallegaladdress}}</span>
                    {{/finallegalshowaddress}}

                    {{#finallegalshowlegal}}
                    <span class="commerce-showroom-final__company-detail"
                        data-showroom-legal-field="legal" {{^hasfinallegallegal}}hidden{{/hasfinallegallegal}}>{{finallegallegal}}</span>
                    {{/finallegalshowlegal}}

                    {{#finallegalshowemail}}
                    <span class="commerce-showroom-final__company-detail"
                        data-showroom-legal-field="email" {{^hasfinallegalemail}}hidden{{/hasfinallegalemail}}>{{finallegalemail}}</span>
                    {{/finallegalshowemail}}

                    {{#finallegalshowphone}}
                    <span class="commerce-showroom-final__company-detail"
                        data-showroom-legal-field="phone" {{^hasfinallegalphone}}hidden{{/hasfinallegalphone}}>{{finallegalphone}}</span>
                    {{/finallegalshowphone}}

                    {{#finallegalshowwebsite}}
                    <span class="commerce-showroom-final__company-detail"
                        data-showroom-legal-field="website" {{^hasfinallegalwebsite}}hidden{{/hasfinallegalwebsite}}>{{finallegalwebsite}}</span>
                    {{/finallegalshowwebsite}}

                    {{#finallegalshowtaxnotice}}
                    <small class="commerce-showroom-final__company-note"
                        data-showroom-legal-field="taxnotice" {{^hasfinallegaltaxnotice}}hidden{{/hasfinallegaltaxnotice}}>{{finallegaltaxnotice}}</small>
                    {{/finallegalshowtaxnotice}}

                    {{#finallegalshowfooter}}
                    <small class="commerce-showroom-final__company-note"
                        data-showroom-legal-field="footer" {{^hasfinallegalfooter}}hidden{{/hasfinallegalfooter}}>{{finallegalfooter}}</small>
                    {{/finallegalshowfooter}}
                </div>
                <nav class="commerce-showroom-final__legal-links" aria-label="{{finallegalnavlabel}}">
                    {{#finallegalshowprivacy}}
                    <a href="{{finallegalprivacyurl}}" target="_blank" rel="noopener noreferrer">{{finallegalprivacylabel}}</a>
                    {{/finallegalshowprivacy}}
                    {{#finallegalshowterms}}
                    <a href="{{finallegaltermsurl}}" target="_blank" rel="noopener noreferrer">{{finallegaltermslabel}}</a>
                    {{/finallegalshowterms}}
                    {{#finallegalshowoffer}}
                    <a href="{{finallegalofferurl}}" target="_blank" rel="noopener noreferrer">{{finallegalofferlabel}}</a>
                    {{/finallegalshowoffer}}
                </nav>
            </div>
        </footer>
    </section>
    {{/isfinalcta}}
    {{/showroomorderedblocks}}

    {{#showblockoffers}}
    {{#showblockfinalcta}}
    <aside class="commerce-showroom-desktop-sticky" data-showroom-desktop-sticky hidden>
        <div class="commerce-showroom-desktop-sticky__layout">
            {{#showexpeditiontheme}}
            <div class="commerce-showroom-desktop-sticky__expedition-glass"
                data-showroom-desktop-expedition hidden aria-hidden="true">
                <span class="commerce-showroom-desktop-sticky__expedition-icon">
                    <i class="{{expeditionicon}}" aria-hidden="true"></i>
                </span>
                <div>
                    <strong>{{expeditionlabel}}</strong>
                    <span>{{expeditionstage}}</span>
                    <small>{{expeditionaltitude}}</small>
                </div>
            </div>
            {{/showexpeditiontheme}}

            <div class="commerce-showroom-desktop-sticky__inner">
                <div>
                    <small>{{desktopstickylabel}}</small>
                    <strong data-showroom-featured-price>{{#hasdesktopstickyprice}}{{desktopstickyprice}}{{/hasdesktopstickyprice}}</strong>
                </div>
                <label class="commerce-showroom-sticky-currency" aria-label="{{currencylabel}}">
                    <select data-showroom-currency-ajax>
                        {{#currencies}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/currencies}}
                    </select>
                </label>
                <a href="{{desktopstickyurl}}" class="commerce-showroom-btn commerce-showroom-btn--primary">{{desktopstickycta}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </aside>
    {{/showblockfinalcta}}
    {{/showblockoffers}}

    {{#showblockoffers}}
    {{#showblockfinalcta}}
    <div class="commerce-showroom-sticky-cta" data-showroom-sticky-cta>
        <label class="commerce-showroom-sticky-currency" aria-label="{{currencylabel}}">
            <select data-showroom-currency-ajax>
                {{#currencies}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/currencies}}
            </select>
        </label>
        <a href="#showroom-offers" data-showroom-smart-anchor>{{herocta}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>
    {{/showblockfinalcta}}
    {{/showblockoffers}}

    {{#showblockvideo}}
    {{#hasvideourl}}
    {{#videomodal}}
    <dialog class="commerce-showroom-video-dialog" data-showroom-video-dialog aria-labelledby="showroom-video-dialog-title">
        <div class="commerce-showroom-video-dialog__panel">
            <button type="button" class="commerce-showroom-video-dialog__close" data-showroom-video-close aria-label="{{videomodalclose}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            <div class="commerce-showroom-video-dialog__stage">
                <h2 id="showroom-video-dialog-title" class="sr-only">{{videotitle}}</h2>
                <video class="commerce-showroom-video-dialog__player" controls preload="none" {{#hasvideoposter}}poster="{{videoposterurl}}"{{/hasvideoposter}}>
                    <source src="{{videourl}}">
                </video>
            </div>
        </div>
    </dialog>
    {{/videomodal}}
    {{/hasvideourl}}
    {{/showblockvideo}}
</main>
