<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-bottom:1px solid #e5e7eb;">
<tr>
    {{#hascover}}
    <td width="78" style="width:78px;padding:14px 12px 14px 0;vertical-align:top;">
        <img src="{{coverurl}}" alt="" width="64" height="64" style="display:block;width:64px;height:64px;object-fit:cover;border-radius:12px;border:1px solid #eee8f1;">
    </td>
    {{/hascover}}
    {{^hascover}}
    <td width="78" style="width:78px;padding:14px 12px 14px 0;vertical-align:top;">
        <img src="{{placeholderurl}}" alt="" width="64" height="64" style="display:block;width:64px;height:64px;object-fit:cover;border-radius:12px;border:1px solid #eee8f1;">
    </td>
    {{/hascover}}
    <td style="padding:14px 10px 14px 0;vertical-align:middle;">
        <div style="font-size:12px;line-height:1.2;color:#6b7280;">
            {{#iscourse}}{{receipt_course_type_label}}{{/iscourse}}
            {{#isdigital}}{{receipt_digital_type_label}}{{/isdigital}}
            {{#isbundle}}{{receipt_bundle_type_label}}{{/isbundle}}
            {{#isservice}}{{receipt_service_type_label}}{{/isservice}}
        </div>
        <div style="margin-top:3px;font-size:16px;line-height:1.3;font-weight:800;color:#38235d;">{{title}}</div>
        <div style="margin-top:4px;font-size:12px;color:#6b7280;">× {{quantity}}</div>
    </td>
    <td width="145" style="width:145px;padding:14px 0;vertical-align:middle;text-align:right;white-space:nowrap;">
        <div style="font-size:16px;line-height:1.2;font-weight:800;color:#241a35;">{{totalformatted}}</div>
        {{#hasdiscount}}{{#hasgross}}<div style="margin-top:4px;font-size:12px;color:#9ca3af;text-decoration:line-through;">{{grossformatted}}</div>{{/hasgross}}{{/hasdiscount}}
    </td>
</tr>
</table>
