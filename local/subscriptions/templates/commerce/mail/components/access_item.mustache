<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:14px 0;border:1px solid #e5e7eb;border-radius:14px;background:#ffffff;">
<tr>
    {{#hascover}}
    <td width="130" style="width:130px;padding:14px 0 14px 14px;vertical-align:top;">
        <img src="{{coverurl}}" alt="" width="112" height="112" style="display:block;width:112px;height:112px;object-fit:cover;border-radius:11px;border:1px solid #eee8f1;">
    </td>
    {{/hascover}}
    {{^hascover}}
    <td width="130" style="width:130px;padding:14px 0 14px 14px;vertical-align:top;">
        <img src="{{placeholderurl}}" alt="" width="112" height="112" style="display:block;width:112px;height:112px;object-fit:cover;border-radius:11px;border:1px solid #eee8f1;">
    </td>
    {{/hascover}}
    <td style="padding:18px;vertical-align:top;">
        <div style="font-size:17px;font-weight:800;line-height:1.3;color:#241a35;">{{title}}</div>
        {{#hasdescription}}<div style="margin-top:5px;color:#6b7280;">{{description}}</div>{{/hasdescription}}

        {{#hasaccesses}}
            {{^isbundle}}
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:14px;">
                    <tr>
                        {{#accesses}}
                            <td style="padding:0 8px 8px 0;vertical-align:top;white-space:nowrap;">
                                {{#iscourse}}
                                    <a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:10px 14px;border:1px solid #f72585;border-radius:9px;background:#f72585;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{course_icon_url}}" alt="" width="15" height="15" style="display:inline-block;width:15px;height:15px;vertical-align:-2px;border:0;">&nbsp;&nbsp;{{#label}}{{label}}{{/label}}{{^label}}{{access_course_label}}{{/label}}</a>
                                {{/iscourse}}
                                {{#isdownload}}
                                    {{#isdesktop}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:10px 14px;border:1px solid #f72585;border-radius:9px;background:#f72585;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{download_icon_url}}" alt="" width="14" height="14" style="display:inline-block;width:14px;height:14px;vertical-align:-2px;border:0;">&nbsp;&nbsp;{{download_desktop_label}}</a>{{/isdesktop}}
                                    {{#ismobile}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:10px 14px;border:1px solid #f72585;border-radius:9px;background:#ffffff;color:#f72585;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{mobile_icon_url}}" alt="" width="12" height="15" style="display:inline-block;width:12px;height:15px;vertical-align:-3px;border:0;">&nbsp;&nbsp;{{download_mobile_label}}</a>{{/ismobile}}
                                    {{^isdesktop}}{{^ismobile}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:10px 14px;border:1px solid #f72585;border-radius:9px;background:#f72585;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{download_icon_url}}" alt="" width="14" height="14" style="display:inline-block;width:14px;height:14px;vertical-align:-2px;border:0;">&nbsp;&nbsp;{{download_label}}</a>{{/ismobile}}{{/isdesktop}}
                                {{/isdownload}}
                            </td>
                        {{/accesses}}
                    </tr>
                </table>
            {{/isbundle}}

            {{#isbundle}}
                <div style="margin-top:14px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#8a7d96;font-weight:800;">{{bundle_contents_label}}</div>
                {{#bundlecomponents}}
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:10px;border-top:1px solid #eee8f1;">
                    <tr>
                        {{#hascover}}
                        <td width="92" style="width:92px;padding:10px 0 6px;vertical-align:top;">
                            <img src="{{coverurl}}" alt="" width="76" height="76" style="display:block;width:76px;height:76px;object-fit:cover;border-radius:9px;border:1px solid #eee8f1;">
                        </td>
                        {{/hascover}}
                        {{^hascover}}
                        <td width="92" style="width:92px;padding:10px 0 6px;vertical-align:top;">
                            <img src="{{placeholderurl}}" alt="" width="76" height="76" style="display:block;width:76px;height:76px;object-fit:cover;border-radius:9px;border:1px solid #eee8f1;">
                        </td>
                        {{/hascover}}
                        <td style="padding:12px 0 4px;vertical-align:top;">
                            {{#hastitle}}<div style="margin-bottom:8px;font-size:14px;font-weight:800;color:#38235d;">{{title}}</div>{{/hastitle}}
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr>
                            {{#accesses}}
                                <td style="padding:0 7px 6px 0;vertical-align:top;white-space:nowrap;">
                                    {{#iscourse}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:9px 13px;border:1px solid #f72585;border-radius:9px;background:#f72585;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{course_icon_url}}" alt="" width="15" height="15" style="display:inline-block;width:15px;height:15px;vertical-align:-2px;border:0;">&nbsp;&nbsp;{{#label}}{{label}}{{/label}}{{^label}}{{access_course_label}}{{/label}}</a>{{/iscourse}}
                                    {{#isdownload}}
                                        {{#isdesktop}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:9px 13px;border:1px solid #f72585;border-radius:9px;background:#f72585;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{download_icon_url}}" alt="" width="14" height="14" style="display:inline-block;width:14px;height:14px;vertical-align:-2px;border:0;">&nbsp;&nbsp;{{download_desktop_label}}</a>{{/isdesktop}}
                                        {{#ismobile}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:9px 13px;border:1px solid #f72585;border-radius:9px;background:#ffffff;color:#f72585;text-decoration:none;font-size:13px;font-weight:800;line-height:1.2;white-space:nowrap;"><img src="{{mobile_icon_url}}" alt="" width="12" height="15" style="display:inline-block;width:12px;height:15px;vertical-align:-3px;border:0;">&nbsp;&nbsp;{{download_mobile_label}}</a>{{/ismobile}}
                                    {{/isdownload}}
                                </td>
                            {{/accesses}}
                            </tr></table>
                        </td>
                    </tr>
                    </table>
                {{/bundlecomponents}}
            {{/isbundle}}
        {{/hasaccesses}}
    </td>
</tr>
</table>
