<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px;">
<tr>
    <td style="padding:18px;background:#f8f5fb;border:1px solid #ece4f1;border-radius:14px;">
        <div style="font-size:18px;font-weight:800;color:#38235d;margin-bottom:5px;">{{welcome_telegram_heading}}</div>
        <div style="font-size:13px;line-height:1.55;color:#6b7280;margin-bottom:14px;">{{welcome_telegram_intro}}</div>
        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
        <tr>
            <td style="padding:0 8px 8px 0;">
                <a href="{{telegramchannelurl}}" target="_blank" rel="noopener noreferrer"
                   style="display:inline-block;background:#229ED9;border-radius:9px;padding:10px 14px;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;">
                    <img src="{{telegramiconurl}}" alt="" width="15" height="15"
                         style="display:inline-block;width:15px;height:15px;vertical-align:-3px;margin-right:7px;border:0;">{{welcome_telegram_channel}}
                </a>
            </td>
            <td style="padding:0 0 8px;">
                <a href="{{telegramgroupurl}}" target="_blank" rel="noopener noreferrer"
                   style="display:inline-block;background:#229ED9;border-radius:9px;padding:10px 14px;color:#ffffff;text-decoration:none;font-size:13px;font-weight:800;">
                    <img src="{{telegramiconurl}}" alt="" width="15" height="15"
                         style="display:inline-block;width:15px;height:15px;vertical-align:-3px;margin-right:7px;border:0;">{{welcome_telegram_group}}
                </a>
            </td>
        </tr>
        </table>
    </td>
</tr>
</table>
