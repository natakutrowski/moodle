{{#has_editorial_heading}}<h1 style="margin:0 0 18px;font-size:28px;line-height:1.2;color:#171827;">{{editorial_heading}}</h1>{{/has_editorial_heading}}
{{#has_editorial_intro}}<div style="margin-bottom:22px;">{{{editorial_intro}}}</div>{{/has_editorial_intro}}

{{#personaloffer.productname}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0;">
<tr>
<td style="padding:1px;border-radius:16px;background:#d5aa45;background:linear-gradient(135deg,#a87312 0%,#f5dc91 35%,#fff3bd 55%,#b87b15 100%);">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-radius:15px;background:#fffaf0;">

<!-- Desktop / wide clients -->
<tr class="po-desktop">
    {{#personaloffer.hascover}}
    <td width="170" style="width:170px;padding:16px 0 16px 16px;vertical-align:stretch;">
        <img src="{{personaloffer.coverurl}}" alt="" width="148" style="display:block;width:148px;height:100%;min-height:188px;object-fit:cover;border-radius:12px;border:1px solid #ead39a;box-shadow:0 5px 14px rgba(88,58,8,.12);">
    </td>
    {{/personaloffer.hascover}}
    <td style="padding:20px 22px 18px;vertical-align:middle;">
        <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#94630d;font-weight:800;white-space:nowrap;">✦ &nbsp;{{personaloffer.offerlabel}}&nbsp; ✦</div>
        <div style="margin-top:8px;font-size:21px;line-height:1.3;font-weight:800;color:#241a35;">{{personaloffer.productname}}</div>

        {{#personaloffer.hasprices}}
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:16px;"><tr>
        {{#personaloffer.prices}}
        <td style="padding:0 8px 0 0;vertical-align:top;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #ead08a;border-radius:11px;background:#ffffff;">
            <tr><td style="padding:9px 12px;">
                <div style="font-size:10px;line-height:1;color:#92733c;font-weight:700;letter-spacing:.08em;">{{flag}} {{currency}}</div>
                <div style="margin-top:5px;font-size:18px;line-height:1.1;color:#6d4808;font-weight:800;">{{amount}} {{symbol}}</div>
            </td></tr>
            </table>
        </td>
        {{/personaloffer.prices}}
        </tr></table>
        {{/personaloffer.hasprices}}

        {{^personaloffer.hasprices}}{{#personaloffer.priceformatted}}<div style="margin-top:12px;font-size:18px;color:#7d5410;font-weight:800;">{{personaloffer.priceformatted}}</div>{{/personaloffer.priceformatted}}{{/personaloffer.hasprices}}

        {{#personaloffer.hasvalidityperiod}}
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid #ead9a8;font-size:12px;color:#7d715f;">
            {{personaloffer.validitylabel}} {{personaloffer.fromlabel}} <strong style="color:#65430b;">{{personaloffer.validfromformatted}}</strong> {{personaloffer.tolabel}} <strong style="color:#65430b;">{{personaloffer.expiresformatted}}</strong>
        </div>
        {{/personaloffer.hasvalidityperiod}}
        {{^personaloffer.hasvalidityperiod}}
            {{#personaloffer.validfromformatted}}<div style="margin-top:13px;font-size:12px;color:#7d715f;">{{personaloffer.validfromlabel}} <strong>{{personaloffer.validfromformatted}}</strong></div>{{/personaloffer.validfromformatted}}
            {{#personaloffer.expiresformatted}}<div style="margin-top:13px;font-size:12px;color:#7d715f;">{{personaloffer.expirylabel}} <strong>{{personaloffer.expiresformatted}}</strong></div>{{/personaloffer.expiresformatted}}
        {{/personaloffer.hasvalidityperiod}}
    </td>
</tr>

<!-- Mobile / narrow clients -->
<tr class="po-mobile" style="display:none;mso-hide:all;">
    <td style="padding:18px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
            <tr>
                <td colspan="2" style="padding-bottom:13px;text-align:center;font-size:11px;letter-spacing:.10em;text-transform:uppercase;color:#94630d;font-weight:800;">
                    ✦ &nbsp;{{personaloffer.offerlabel}}&nbsp; ✦
                </td>
            </tr>
            <tr>
                {{#personaloffer.hascover}}
                <td width="92" style="width:92px;padding:0 12px 14px 0;vertical-align:middle;">
                    <img src="{{personaloffer.coverurl}}" alt="" width="86" height="86" style="display:block;width:86px;height:86px;object-fit:cover;border-radius:11px;border:1px solid #ead39a;">
                </td>
                {{/personaloffer.hascover}}
                <td style="padding:0 0 14px;vertical-align:middle;">
                    <div style="font-size:20px;line-height:1.25;font-weight:800;color:#241a35;">{{personaloffer.productname}}</div>
                </td>
            </tr>
            {{#personaloffer.hasprices}}
            <tr>
                <td colspan="2" style="padding:0 0 12px;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                        <tr>
                        {{#personaloffer.prices}}
                            <td style="padding:0 8px 0 0;vertical-align:top;">
                                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #ead08a;border-radius:11px;background:#ffffff;">
                                <tr><td style="padding:9px 12px;">
                                    <div style="font-size:10px;line-height:1;color:#92733c;font-weight:700;letter-spacing:.08em;">{{flag}} {{currency}}</div>
                                    <div style="margin-top:5px;font-size:18px;line-height:1.1;color:#6d4808;font-weight:800;">{{amount}} {{symbol}}</div>
                                </td></tr>
                                </table>
                            </td>
                        {{/personaloffer.prices}}
                        </tr>
                    </table>
                </td>
            </tr>
            {{/personaloffer.hasprices}}
            {{^personaloffer.hasprices}}
                {{#personaloffer.priceformatted}}
                <tr><td colspan="2" style="padding:0 0 12px;font-size:18px;color:#7d5410;font-weight:800;">{{personaloffer.priceformatted}}</td></tr>
                {{/personaloffer.priceformatted}}
            {{/personaloffer.hasprices}}
            <tr>
                <td colspan="2" style="padding-top:11px;border-top:1px solid #ead9a8;font-size:12px;line-height:1.5;color:#7d715f;">
                    {{#personaloffer.hasvalidityperiod}}
                        {{personaloffer.validitylabel}} {{personaloffer.fromlabel}} <strong style="color:#65430b;">{{personaloffer.validfromformatted}}</strong> {{personaloffer.tolabel}} <strong style="color:#65430b;">{{personaloffer.expiresformatted}}</strong>
                    {{/personaloffer.hasvalidityperiod}}
                    {{^personaloffer.hasvalidityperiod}}
                        {{#personaloffer.validfromformatted}}{{personaloffer.validfromlabel}} <strong>{{personaloffer.validfromformatted}}</strong>{{/personaloffer.validfromformatted}}
                        {{#personaloffer.expiresformatted}} {{personaloffer.expirylabel}} <strong>{{personaloffer.expiresformatted}}</strong>{{/personaloffer.expiresformatted}}
                    {{/personaloffer.hasvalidityperiod}}
                </td>
            </tr>
        </table>
    </td>
</tr>

</table>
</td>
</tr>
</table>
{{/personaloffer.productname}}

{{#has_editorial_outro}}<div style="margin-top:22px;">{{{editorial_outro}}}</div>{{/has_editorial_outro}}
{{#has_editorial_signature}}<div style="margin-top:18px;">{{{editorial_signature}}}</div>{{/has_editorial_signature}}
