<div class="commerce-payment-reassurance mt-4 pt-3 border-top">
    <div class="commerce-payment-reassurance__benefit small text-muted">
        <span aria-hidden="true">⚡</span>
        <span>{{instantaccesslabel}}</span>
    </div>
    <div class="commerce-payment-reassurance__security small text-muted">
        <span aria-hidden="true">🔒</span>
        <span>{{paymentsecurelabel}}</span>
    </div>
    <div class="commerce-payment-reassurance__icons d-flex align-items-center justify-content-center gap-2" aria-label="{{paymentsecurelabel}}">
        <img src="{{stripeiconurl}}" alt="Stripe">
        <img src="{{alfaiconurl}}" alt="Alfa Bank">
        <img src="{{visaiconurl}}" alt="Visa">
        <img src="{{mastercardiconurl}}" alt="Mastercard">
    </div>
</div>
