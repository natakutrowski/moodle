<div class="campus-mycourses-empty container">
    <div class="campus-mycourses-empty__card">
        <div class="campus-mycourses-empty__icon" aria-hidden="true">
            <i class="fa-solid fa-book-open-reader"></i>
        </div>
        <h2 class="campus-mycourses-empty__title">{{empty.title}}</h2>
        <p class="campus-mycourses-empty__text">{{empty.text}}</p>
        <div class="campus-mycourses-empty__actions">
            <a class="default-btn campus-mycourses-empty__primary" href="{{empty.storefronturl}}">
                <i class="fa-solid fa-store" aria-hidden="true"></i>
                <span>{{empty.storefrontlabel}}</span>
            </a>
            <a class="campus-mycourses-empty__secondary" href="{{empty.trialurl}}">
                <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                <span>{{empty.triallabel}}</span>
            </a>
        </div>
    </div>
</div>
