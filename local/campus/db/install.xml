<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/campus/db" VERSION="2025102100" COMMENT="Install XML for local_campus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <TABLES>
    <TABLE NAME="local_campus_trial" COMMENT="Trial access tokens, one per email">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="email" TYPE="char" LENGTH="255" NOTNULL="true" />
        <FIELD NAME="firstname" TYPE="char" LENGTH="100" NOTNULL="true" />
        <FIELD NAME="lastname" TYPE="char" LENGTH="100" NOTNULL="true" />
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" />
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" />
        <FIELD NAME="expiresat" TYPE="int" LENGTH="10" NOTNULL="true" />
        <FIELD NAME="lastseen" TYPE="int" LENGTH="10" NOTNULL="false" />
        <FIELD NAME="reminder3_sent" TYPE="int" LENGTH="10" NOTNULL="false" />
        <FIELD NAME="reminder7_sent" TYPE="int" LENGTH="10" NOTNULL="false" />
        <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" COMMENT="1=active,2=expired,3=banned"/>
        <FIELD NAME="ipaddress" TYPE="char" LENGTH="45" NOTNULL="false" />
        <FIELD NAME="useragent" TYPE="text" NOTNULL="false" />

      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="email_ix" TYPE="index" FIELDS="email"/>
        <KEY NAME="expires_ix" TYPE="index" FIELDS="expiresat"/>
        <KEY NAME="status_ix" TYPE="index" FIELDS="status"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
