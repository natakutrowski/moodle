{{!
    @template local_xp/oauth/authorize

    OAuth authorization page for Level Up XP MCP clients.

    Example context (json):
    {
    }
}}
<div class="xp-mx-auto xp-my-8 xp-max-w-xl">
    <div class="xp-rounded-xl xp-border xp-border-gray-200 dark:xp-border-gray-700 xp-bg-white dark:xp-bg-gray-900 dark:xp-text-gray-100 xp-py-6 xp-px-10 xp-shadow">
        <div class="xp-text-center">
            <h1 class="xp-mb-3 xp-text-2xl">{{ errorheading }}</h1>
            <p class="xp-mb-0 xp-text-gray-700 dark:xp-text-gray-300">{{ error }}</p>
        </div>
        <div class="xp-mt-6 xp-flex xp-justify-center">
            {{{ cancelbutton }}}
        </div>
    </div>
</div>
