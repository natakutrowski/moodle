{{!
    @template local_xp/oauth/authorize

    OAuth authorization page for Level Up XP MCP clients.

    Example context (json):
    {
    }
}}
<div class="xp-mx-auto xp-my-8 xp-max-w-xl">
    <div class="xp-rounded-xl xp-border xp-border-gray-200 dark:xp-border-gray-700 xp-bg-white dark:xp-bg-gray-900 dark:xp-text-gray-100 xp-py-6 xp-px-10 xp-shadow">
        <div class="xp-text-center">
            {{# logourl }}
                <div class="xp-flex xp-h-28 xp-items-center xp-justify-center" aria-hidden="true">
                    <img src="{{ logourl }}" alt="" class="xp-max-h-full xp-max-w-48 xp-object-contain">
                </div>
            {{/ logourl }}
            {{^ logourl }}
                <div class="xp-rounded-lg xp-shadow-sm xp-mx-auto xp-mb-5 xp-flex xp-h-32 xp-w-32 xp-items-center xp-justify-center" aria-hidden="true">
                    <span style="font-size: 4rem;">✨</span>
                </div>
            {{/ logourl }}
            <h1 class="xp-mt-5 xp-mb-2 xp-text-2xl xp-font-semibold xp-leading-tight xp-text-gray-900 dark:xp-text-gray-100">{{ title }}</h1>
            {{# origin }}
                <p class="xp-mb-2 xp-text-sm xp-text-gray-500 dark:xp-text-gray-400">{{ origin }}</p>
            {{/ origin }}
            <p class="xp-m-0 xp-text-sm xp-text-gray-700 dark:xp-text-gray-300">{{ signedinas }}</p>
        </div>

        <div class=" xp-my-6">
            <p class="xp-mb-3 xp-font-bold">{{ permissionsheading }}</p>
            <ul class="xp-mb-0 xp-pl-5 xp-text-gray-700 dark:xp-text-gray-300">
                {{# permissions }}
                    <li class="xp-mb-2">{{ text }}</li>
                {{/ permissions }}
            </ul>
        </div>

        <p class="xp-my-6">{{ warning }}</p>

        <div class="">
            <div class="xp-flex xp-flex-wrap xp-justify-end xp-gap-3 [&_.singlebutton]:xp-m-0">
                {{{ cancelbutton }}}
                {{{ authorizebutton }}}
            </div>
            {{# redirecturi }}
                <div class="xp-mt-6 xp-text-center xp-text-sm xp-text-gray-600 dark:xp-text-gray-400">
                    <div>{{ redirectlabel }}</div>
                    <div class="xp-mt-1 xp-break-all">{{ redirecturi }}</div>
                </div>
            {{/ redirecturi }}
        </div>
    </div>
</div>
