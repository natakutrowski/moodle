{{!
    @template local_xp/source-courses-empty

    Empty state for a global world with no source courses.

    Example context (json):
    {}
}}
<div class="xp-rounded xp-border-dashed xp-border-2 xp-p-4 xp-py-6 xp-text-center xp-border-gray-200 dark:xp-border-gray-700">
    <h3 class="xp-text-xl xp-font-bold xp-mb-4">{{#str}}globalpointsempty, block_xp{{/str}}</h3>
    <p class="xp-mb-0">{{#str}}globalpointsemptyintro, block_xp{{/str}}</p>
    <div class="xp-mt-4">
        <button type="button" class="btn btn-primary" data-xp-action="add-source">{{#str}}addcourses, block_xp{{/str}}</button>
    </div>
</div>
