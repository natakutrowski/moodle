{{!
    @template local_xp/user-sources-heading

    User name with a back button to the report.

    Example context (json):
    {
        "name": "Alex Taylor",
        "backurl": "/blocks/xp/index.php/report/1"
    }
}}
<div class="xp-flex xp-items-center xp-gap-3 xp-mb-6">
    <div class="xp-h-10 xp-w-10 xp-flex xp-items-center">
        <a class="xp-h-10 xp-w-10 xp-transition-colors xp-text-inherit xp-flex xp-justify-center xp-items-center xp-rounded-full xp-bg-gray-100 hover:xp-bg-gray-200 dark:xp-bg-gray-800 dark:hover:xp-bg-gray-700" href="{{ backurl }}"
                data-toggle="tooltip" data-bs-toggle="tooltip"
                title={{#quote}}{{#str}}back, core{{/str}}{{/quote}}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="xp-h-7 xp-w-7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
            <span class="xp-sr-only">{{#str}} back, core {{/str}}</span>
        </a>
    </div>
    <h3 class="xp-m-0">{{name}}</h3>
</div>
