        <div class="gu-w-full gu-text-sm gu-mt-4 gu-text-gray-500 gu-text-center">
            <p class="gu-m-0"><a href="{{ levelupurl }}">levelup.plus</a></p>
            <div>{{ activationid }}</div>
            <div>
                <a href=""></a>
                <a href=""></a>
            </div>
        </div>
        {{/ canmanagelicence }}
        {{^ canmanagelicence }}
        <p>{{#str}} licenceexpiredcontactadmin, block_gearup {{/str}}</p>
        {{/ canmanagelicence }}
    </div>
</div>
{{#js}}
require(['block_gearup/confetti-lazy'], function(Confettis) {
    const purgeUrl = "{{{ purgeurl }}}"
    const deactivateUrl = "{{{ deactivateurl }}}"
    const wantedForPurge = ["ArrowLeft", "ArrowLeft", "ArrowRight", "ArrowRight", "ArrowLeft", "ArrowRight", "p"];
    const wantedForDeactivate = ["ArrowUp", "ArrowUp", "ArrowRight", "ArrowRight", "ArrowLeft", "ArrowRight", "d"];
    let seq = [];
    let t;

    document.addEventListener('keydown', function(e) {
        clearTimeout(t);

        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "p", "d"].includes(e.key)) {
            return;
        }
        seq = seq.concat([e.key]).slice(-10);

        if (seq.slice(-wantedForPurge.length).join(',') === wantedForPurge.join(',')) {
            seq = [];
            Confettis.throwRandomConfettis();
            setTimeout(() => {
                window.location.href = purgeUrl;
            }, 1000)
            return;
        }

        if (seq.slice(-wantedForDeactivate.length).join(',') === wantedForDeactivate.join(',')) {
            seq = [];
            if (confirm('Are you sure that you want to deactivate Level Up Quest?')) {
                Confettis.getJsConfetti().addConfetti({
                    emojis: ['😢', '😭', '😱', '😨', '😿'],
                });
                setTimeout(() => {
                    window.location.href = deactivateUrl;
                }, 1000);
            }
            return;
        }

        t = setTimeout(function() {
            seq = [];
        }, 1200);
    })
})
{{/js}}