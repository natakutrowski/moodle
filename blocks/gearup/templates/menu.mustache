<div class="dropdown">
  <button class="btn btn-link btn-icon icon-size-3 rounded-circle" data-bs-toggle="dropdown" data-toggle="dropdown" type="button" aria-expanded="false">
    <i class="fa fa-ellipsis-v text-dark py-2" aria-hidden="true"></i>
    <span class="gu-sr-only">{{#str}}menu, block_gearup{{/str}}</span>
  </button>
  <div class="dropdown-menu dropdown-menu-right">
    {{# menuitems }}
      {{#isdivider}}
        <div class="dropdown-divider"></div>
      {{/isdivider}}
      {{^isdivider}}
        <a class="dropdown-item {{#classes}}{{.}} {{/classes}}" {{#attributes}}{{name}}="{{value}}" {{/attributes}}>
          {{ label }}</a>
      {{/isdivider}}
    {{/ menuitems }}
  </div>
</div>
