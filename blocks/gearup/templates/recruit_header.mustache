<div class="gu-flex gu-gap-2">
    <div class="gu-shrink-0 gu-grow-0">
        <a href="{{ profileurl }}" class="gu-inline-block aabtn" aria-describedby="gu-user-{{uniqid}}">
            <img src="{{ picurl}}" alt="" role="decoration" class="gu-rounded-full gu-size-11 no-underline gu-inline-block" aria-hidden>
            <span class="gu-sr-only">{{#str}} profile, core {{/str}}</span>
        </a>
    </div>
    <div class="gu-grow">
        <h2 class="gu-m-0 gu-text-3xl gu-leading-none gu-font-medium" id="gu-user-{{uniqid}}">{{ name }}</h2>
        {{#hasidentityfields}}
            <div class="gu-text-xs gu-text-gray-500">
                {{#identityfields}}
                    <span class="gu-peer">{{ value }}</span><span class="last:gu-hidden peer-empty:gu-hidden">, </span>
                {{/identityfields}}
            </div>
        {{/hasidentityfields}}
    </div>
</div>