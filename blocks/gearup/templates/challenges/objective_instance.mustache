<div class="gu-flex gu-gap-2 gu-flex-nowrap">
    <div class="gu-shrink-0 gu-grow-0 gu-leading-none gu-pt-0.5">
        {{#iscompleted}}
        <svg xmlns="http://www.w3.org/2000/svg" class="gu-h-5 gu-w-5 gu-text-green-700" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M12 2.005c-.777 0 -1.508 .367 -1.971 .99l-5.362 6.895c-.89 1.136 -.89 3.083 0 4.227l5.375 6.911a2.457 2.457 0 0 0 3.93 -.017l5.361 -6.894c.89 -1.136 .89 -3.083 0 -4.227l-5.375 -6.911a2.446 2.446 0 0 0 -1.958 -.974z" stroke-width="0" fill="currentColor"></path>
        </svg>
        <span class="gu-sr-only">{{#str}} completed, block_gearup {{/str}}</span>
        {{/iscompleted}}
        {{^iscompleted}}
        <svg xmlns="http://www.w3.org/2000/svg" class="gu-h-5 gu-w-5 gu-text-gray-200" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M10.831 20.413l-5.375 -6.91c-.608 -.783 -.608 -2.223 0 -3l5.375 -6.911a1.457 1.457 0 0 1 2.338 0l5.375 6.91c.608 .783 .608 2.223 0 3l-5.375 6.911a1.457 1.457 0 0 1 -2.338 0z"></path>
        </svg>
        <span class="gu-sr-only">{{#str}} incomplete, block_gearup {{/str}}</span>
        {{/iscompleted}}
    </div>
    <div class="gu-grow gu-items-center gu-flex gu-w-full gu-leading-tight">
        <div>
            {{ objective.label }}
            {{#objective.supportingurl}}
            <div class="gu-inline-block gu-leading-none gu-w-4 gu-relative">&nbsp;
                <a href="{{ . }}" target="_blank" rel="noopener noreferer" class="gu-absolute gu--inset-1 gu-leading-none gu-block gu-size-6 gu-p-1 gu-text-inherit gu-rounded gu-no-underline gu-bg-gray-100 gu-bg-opacity-0 hover:gu-bg-opacity-100 gu-transition-colors" data-toggle="tooltip" data-bs-toggle="tooltip" title="{{#str}} opensupportinglink, block_gearup {{/str}}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="gu-size-4">
                        <path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                        <path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                    </svg>
                </a>
            </div>
            {{/objective.supportingurl}}
        </div>
    </div>
    {{#objective.iscountable}}<div class="gu-grow-0 gu-shrink-0 gu-whitespace-nowrap gu-text-gray-700"><span class="gu-text-sm">({{counter}}/{{objective.countneeded}})</span></div>{{/objective.iscountable}}
</div>
