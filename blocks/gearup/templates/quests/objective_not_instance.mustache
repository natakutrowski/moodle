<div class="gu-flex gu-gap-2 gu-flex-nowrap">
    <div class="gu-shrink-0 gu-grow-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="gu-h-6 gu-w-6 gu-text-gray-200" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M5 12l5 5l10 -10"></path>
        </svg>
        <span class="gu-sr-only">{{#str}} incomplete, block_gearup {{/str}}</span>
    </div>
    <div class="gu-grow">
        {{ label }}
        {{#supportingurl}}
        <div class="gu-inline-block gu-leading-none gu-w-4 gu-relative">&nbsp;
            <a href="{{ . }}" target="_blank" rel="noopener noreferer" class="gu-absolute gu--inset-1 gu-leading-none gu-block gu-size-6 gu-p-1 gu-text-inherit gu-rounded gu-no-underline gu-bg-gray-100 gu-bg-opacity-0 hover:gu-bg-opacity-100 gu-transition-colors" data-toggle="tooltip" data-bs-toggle="tooltip" title="{{#str}} opensupportinglink, block_gearup {{/str}}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="gu-size-4">
                    <path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                </svg>
            </a>
        </div>
        {{/supportingurl}}
    </div>
    {{#iscountable}}<div class="gu-grow-0 gu-shrink-0 gu-text-gray-700 gu-whitespace-nowrap"><span class="gu-text-sm">(0/{{countneeded}})</span></div>{{/iscountable}}
</div>
