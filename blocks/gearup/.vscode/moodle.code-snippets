{
	// Place your gearup workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"get_string": {
		"scope": "php",
		"prefix": [
			"getstr",
			"get_string"
		],
		"body": [
			"get_string('${1}', '${2:block_gearup}')$0"
		],
		"description": "Shortcut to get_string()."
	},
	"get_in_or_equal": {
		"scope": "php",
		"prefix": [
			"get_in_or_equal",
			"getin"
		],
		"body": [
			"list(\\$${1}insql, \\$${1}inparams) = \\$DB->get_in_or_equal(\\$${2:ids});$0"
		],
		"description": "Shortcut to $DB->get_in_or_equal()."
	},
	"lang_string": {
		"scope": "php",
		"prefix": [
			"new lang",
			"langstr"
		],
		"body": [
			"new \\lang_string('${1}', '${2:block_gearup}')$0"
		],
		"description": "Shortcut to new lang_string()."
	},
	"$string[''] = ''": {
		"scope": "php",
		"prefix": [
			"str",
			"$str"
		],
		"body": [
			"\\$string['${1}'] = '${2}';$0"
		],
		"description": "Shortcut to $string[''] = ..."
	},
	"Mustache {{#str}}": {
		"scope": "html",
		"prefix": "str",
		"body": [
			"{{#str}} $1, block_gearup {{/str}}$0"
		],
		"description": "Moodle string output in Mustache."
	},
	"Mustache {{#js}}": {
		"scope": "html",
		"prefix": "js",
		"body": [
			"{{#js}}",
			"require([$1], function($2) {",
			"    $0",
			"});",
			"{{/js}}",
		],
		"description": "JavaScript block in Mustache."
	},
	"Mustache if": {
		"scope": "html",
		"prefix": "if",
		"body": [
			"{{# ${variable} }}$0{{/ ${variable} }}",
		],
		"description": "Condition block in Mustache."
	},
	"Mustache else": {
		"scope": "html",
		"prefix": "else",
		"body": [
			"{{^ ${variable} }}$0{{/ ${variable} }}",
		],
		"description": "Negative condition block in Mustache."
	},
	"Mustache for-loop": {
		"scope": "html",
		"prefix": "for",
		"body": [
			"{{# ${variable} }}",
			"    $0",
			"{{/ ${variable} }}",
		],
		"description": "Condition block in Mustache."
	}
}