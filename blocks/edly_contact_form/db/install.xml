<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/edly_contact_form/db" VERSION="2025101902" COMMENT="Edly contact form">
  <TABLES>
    <TABLE NAME="block_edly_contact_msg" COMMENT="Messages envoyés via le formulaire de contact">
      <FIELDS>
        <FIELD NAME="id"               TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="timecreated"      TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"           TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="blockinstanceid"  TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fullname"         TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="email"            TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="message"          TYPE="text" NOTNULL="false"/>
        <FIELD NAME="recipient"        TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="ip"               TYPE="char" LENGTH="64"  NOTNULL="false"/>
        <FIELD NAME="useragent"        TYPE="text" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_time"  UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="idx_email" UNIQUE="false" FIELDS="email"/>
        <INDEX NAME="idx_block" UNIQUE="false" FIELDS="blockinstanceid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
